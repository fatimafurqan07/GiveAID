@model GiveAID_Project.Models.AdminDashboardViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Admin Overview | GiveAID";
    ViewBag.AdminPageTitle = "Administration";
    ViewBag.AdminPageSubtitle = "GiveAID management workspace";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var adminName = Convert.ToString(Session["UserName"]);

    if (string.IsNullOrWhiteSpace(adminName))
    {
        adminName = "Administrator";
    }

    var completedCount = Model.AllDonations == null
        ? 0
        : Model.AllDonations.Count(item =>
            string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase));

    var pendingCount = Model.AllDonations == null
        ? 0
        : Model.AllDonations.Count(item =>
            string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase));
}

<main class="page" id="overview">
    <header class="page-head">
        <div>
            <span class="eyebrow">Platform overview</span>
            <h1>Welcome back, @adminName</h1>
            <p>Monitor platform activity and continue directly to verified management workflows.</p>
        </div>

        <span class="live-pill">
            <span class="live-dot" aria-hidden="true"></span>
            Connected to live database
        </span>
    </header>

    <section class="stats" aria-label="Platform statistics">
        <article class="stat">
            <div class="stat-top"><span class="stat-code">US</span></div>
            <div class="stat-value">@Model.TotalUsers</div>
            <div class="stat-label">Active users</div>
        </article>

        <article class="stat">
            <div class="stat-top"><span class="stat-code">NG</span></div>
            <div class="stat-value">@Model.TotalNGOs</div>
            <div class="stat-label">Associated NGOs</div>
        </article>

        <article class="stat">
            <div class="stat-top"><span class="stat-code">PR</span></div>
            <div class="stat-value">@Model.TotalPrograms</div>
            <div class="stat-label">Open programmes</div>
        </article>

        <article class="stat completed">
            <div class="stat-top"><span class="stat-code">PKR</span></div>
            <div class="stat-value">@Model.TotalFundsRaised.ToString("N0")</div>
            <div class="stat-label">Completed funds (PKR)</div>
        </article>

        <article class="stat pending">
            <div class="stat-top"><span class="stat-code">PN</span></div>
            <div class="stat-value">@pendingCount</div>
            <div class="stat-label">Pending donations</div>
        </article>
    </section>

    <section class="admin-grid">
        <article class="admin-card">
            <header class="admin-card-head">
                <div>
                    <h2>Recent users</h2>
                    <p>Latest accounts registered on the platform.</p>
                </div>

                <a class="overview-link" href="@Url.Action("Users", "Dashboard")">
                    Manage users
                </a>
            </header>

            @if (Model.RecentUsers != null && Model.RecentUsers.Any())
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th>Joined</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                var userInitial = string.IsNullOrWhiteSpace(user.FullName)
                                    ? "U"
                                    : user.FullName.Substring(0, 1).ToUpperInvariant();

                                <tr>
                                    <td>
                                        <div class="user-cell">
                                            <span class="user-mark">@userInitial</span>
                                            <div>
                                                <div class="primary-text">@user.FullName</div>
                                                <div class="secondary-text">@user.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="status-badge @(string.Equals(user.RoleName, "Admin", StringComparison.OrdinalIgnoreCase) ? "status-admin" : "status-user")">
                                            @user.RoleName
                                        </span>
                                    </td>
                                    <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="status-badge @(user.IsActive ? "status-active" : "status-inactive")">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">No registered users are available yet.</div>
            }
        </article>

        <article class="admin-card">
            <header class="admin-card-head">
                <div>
                    <h2>Management centre</h2>
                    <p>Open a verified administration module.</p>
                </div>
            </header>

            <div class="quick-module-grid">
                <a class="quick-module" href="@Url.Action("AdminDonations", "Dashboard")">
                    <span class="quick-module-code">DONATIONS</span>
                    <strong>Review contributions</strong>
                    <span>@pendingCount pending record(s) require attention.</span>
                </a>

                <a class="quick-module" href="@Url.Action("Users", "Dashboard")">
                    <span class="quick-module-code">USERS</span>
                    <strong>Manage accounts</strong>
                    <span>Search users and safely control platform access.</span>
                </a>

                <a class="quick-module" href="@Url.Action("Index", "NGO")">
                    <span class="quick-module-code">NGOS</span>
                    <strong>NGO directory</strong>
                    <span>Review organisations currently visible on the website.</span>
                </a>

                <a class="quick-module" href="@Url.Action("Index", "Causes")">
                    <span class="quick-module-code">CAUSES</span>
                    <strong>Cause directory</strong>
                    <span>Review active causes and connected programmes.</span>
                </a>
            </div>
        </article>
    </section>

    <section class="admin-card" style="margin-top: 20px;">
        <header class="admin-card-head">
            <div>
                <h2>Donation activity</h2>
                <p>Review pending records and monitor completed contributions.</p>
            </div>

            <div>
                <span class="record-count">@pendingCount pending / @completedCount completed</span>
                <a class="overview-link" href="@Url.Action("AdminDonations", "Dashboard")">
                    Open full management
                </a>
            </div>
        </header>

        @if (Model.AllDonations != null && Model.AllDonations.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Donor</th>
                            <th>Destination</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var donation in Model.AllDonations)
                        {
                            var state = (donation.Status ?? "Pending").ToLowerInvariant();
                            var badgeClass = state == "completed"
                                ? "badge-completed"
                                : state == "pending"
                                    ? "badge-pending"
                                    : state == "cancelled" || state == "failed"
                                        ? "badge-cancelled"
                                        : "badge-other";

                            <tr>
                                <td><div class="primary-text">@donation.PaymentReference</div></td>
                                <td>
                                    <div class="primary-text">@donation.DonorName</div>
                                    <div class="secondary-text">@donation.DonorEmail</div>
                                </td>
                                <td>
                                    <div class="primary-text">@donation.NGOName</div>
                                    <div class="secondary-text">@donation.CauseName</div>
                                </td>
                                <td><strong>PKR @donation.Amount.ToString("N0")</strong></td>
                                <td>@donation.DonationDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge @badgeClass">@donation.Status</span></td>
                                <td>
                                    @if (state == "pending")
                                    {
                                        using (Html.BeginForm("ApproveDonation", "Dashboard", FormMethod.Post, new { style = "display:inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="donationId" value="@donation.DonationID" />
                                            <button class="decision decision-complete" type="submit">Complete</button>
                                        }

                                        using (Html.BeginForm("DenyDonation", "Dashboard", FormMethod.Post, new { style = "display:inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="donationId" value="@donation.DonationID" />
                                            <input type="hidden" name="remarks" value="Cancelled by administrator" />
                                            <button class="decision decision-cancel" type="submit">Cancel</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="protected-label">Reviewed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                No donation records are available. New contributions will appear here automatically.
            </div>
        }
    </section>
</main>
