@model GiveAID_Project.Models.NgoDashboardViewModel

@{
    ViewBag.Title = "NGO Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-wrapper">
    <!-- Header Banner -->
    <div class="dashboard-header">
        <div>
            <div class="dashboard-badge ngo-badge">🏢 Partner NGO Portal</div>
            <h1 class="dashboard-title">@Model.NGOName</h1>
            <p class="dashboard-subtitle">Manage your philanthropic programs, monitor fundraising milestones, and engage with your supporters.</p>
        </div>
        <div class="dashboard-actions">
            <span class="status-pill status-completed">✓ @Model.Status Partner</span>
        </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon icon-funds">💰</div>
            <div class="stat-info">
                <div class="stat-value">$@Model.TotalRaised.ToString("N0")</div>
                <div class="stat-label">Total Raised to Date</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-users">🤝</div>
            <div class="stat-info">
                <div class="stat-value">@Model.TotalDonorsCount</div>
                <div class="stat-label">Unique Donors</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-programs">📋</div>
            <div class="stat-info">
                <div class="stat-value">@Model.TotalProgramsCount</div>
                <div class="stat-label">Active Programs</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-ngo">⭐</div>
            <div class="stat-info">
                <div class="stat-value">@Model.TotalInterestedUsersCount</div>
                <div class="stat-label">Interested Supporters</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="dashboard-charts-grid">
        <div class="dashboard-card chart-card">
            <div class="card-header">
                <h3>📊 Program Funding Milestones</h3>
                <span class="card-subtitle">Current amount raised vs campaign target</span>
            </div>
            <div class="chart-container">
                <canvas id="ngoProgramsChart"></canvas>
            </div>
        </div>

        <div class="dashboard-card chart-card">
            <div class="card-header">
                <h3>📈 Monthly Donation Inflow</h3>
                <span class="card-subtitle">Recent monthly contribution trends</span>
            </div>
            <div class="chart-container">
                <canvas id="ngoMonthlyChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Programs Progress Table -->
    <div class="dashboard-card mb-4">
        <div class="card-header">
            <h3>🎯 Your Active Programs</h3>
            <span class="card-subtitle">Fundraising campaign progress and status</span>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Program Name</th>
                        <th>Cause & Location</th>
                        <th>Target Amount</th>
                        <th>Raised so far</th>
                        <th>Progress</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Programs != null && Model.Programs.Any())
                    {
                        foreach (var prog in Model.Programs)
                        {
                            <tr>
                                <td><strong>@prog.ProgramName</strong></td>
                                <td>
                                    <div>@prog.CauseName</div>
                                    <div class="text-sub">📍 @prog.Location</div>
                                </td>
                                <td>$@prog.TargetAmount.ToString("N0")</td>
                                <td class="amount-cell">$@prog.CurrentAmount.ToString("N0")</td>
                                <td style="min-width: 160px;">
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill" style="width: @(prog.ProgressPercent)%"></div>
                                    </div>
                                    <div class="progress-text">@prog.ProgressPercent% funded (@prog.InterestedCount supporters interested)</div>
                                </td>
                                <td><span class="status-pill status-completed">@prog.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No programs created yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Split Grid: All Donations & Top Supporters -->
    <div class="dashboard-tables-grid">
        <!-- All Donations with Status -->
        <div class="dashboard-card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                    <h3>💳 Donations Received</h3>
                    <span class="card-subtitle">All contributions to your programs with verification status</span>
                </div>
                @if (Model.PendingDonationsCount > 0)
                {
                    <span class="status-pill status-pending" style="font-size: 12px;">@Model.PendingDonationsCount Pending Admin Review</span>
                }
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Donor</th>
                            <th>Program</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AllDonations != null && Model.AllDonations.Any())
                        {
                            foreach (var d in Model.AllDonations)
                            {
                                bool dPending = d.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase);
                                bool dApproved = d.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase);

                                <tr>
                                    <td><code class="ref-code">@d.PaymentReference</code></td>
                                    <td>
                                        <strong>@d.DonorName</strong>
                                        <div class="text-sub">@d.DonorEmail</div>
                                    </td>
                                    <td>@(d.ProgramName ?? d.CauseName)</td>
                                    <td class="amount-cell">PKR @d.Amount.ToString("N0")</td>
                                    <td>@d.DonationDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (dApproved)
                                        {
                                            <span class="status-pill" style="background-color: #dcfce7; color: #166534;">✓ Approved</span>
                                        }
                                        else if (dPending)
                                        {
                                            <span class="status-pill status-pending">⏳ Pending</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill" style="background-color: #fee2e2; color: #991b1b;">✕ Denied</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <button type="button" class="btn-action btn-view-details" onclick="viewNgoDonation(@d.DonationID)">
                                            🔍 View
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">No donations received yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Top Supporters -->
        <div class="dashboard-card">
            <div class="card-header">
                <h3>🏆 Top Benefactors & Donors</h3>
                <span class="card-subtitle">Key supporters driving your mission</span>
            </div>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Supporter</th>
                            <th>Donations</th>
                            <th>Total Donated</th>
                            <th>Last Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopSupporters != null && Model.TopSupporters.Any())
                        {
                            foreach (var s in Model.TopSupporters)
                            {
                                <tr>
                                    <td>
                                        <strong>@s.SupporterName</strong>
                                        <div class="text-sub">@s.SupporterEmail</div>
                                    </td>
                                    <td>@s.DonationsCount gifts</td>
                                    <td class="amount-cell">PKR @s.TotalDonated.ToString("N0")</td>
                                    <td>@s.LastDonationDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No supporters recorded yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     NGO DONATION DETAIL MODAL (READ-ONLY — NO APPROVE/DENY)
     ========================================================= -->
<div class="donation-modal-overlay" id="ngoDonationModal" style="display: none;">
    <div class="donation-modal-card" style="max-width: 520px;">
        <button type="button" class="modal-close-btn" onclick="$('#ngoDonationModal').fadeOut(200)">&times;</button>
        <div class="modal-header">
            <div class="modal-icon">💳</div>
            <h3 id="ngoDonTitle">Donation Details</h3>
            <p id="ngoDonRef" class="text-sub"></p>
        </div>

        <div class="modal-body" style="font-size: 14px; color: #334155;">
            <div class="details-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px;">
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Donor:</label>
                    <div id="ngoDonDonor" style="font-weight: 600;"></div>
                </div>
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Email:</label>
                    <div id="ngoDonEmail" style="font-weight: 600;"></div>
                </div>
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Cause:</label>
                    <div id="ngoDonCause" style="font-weight: 600;"></div>
                </div>
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Program:</label>
                    <div id="ngoDonProgram" style="font-weight: 600;"></div>
                </div>
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Payment Method:</label>
                    <div id="ngoDonPayMethod" style="font-weight: 600;"></div>
                </div>
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Date:</label>
                    <div id="ngoDonDate" style="font-weight: 600;"></div>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-top: 1px dashed #cbd5e1;">
                <div>
                    <label class="form-label" style="margin-bottom: 2px;">Status:</label>
                    <span id="ngoDonStatus"></span>
                </div>
                <div>
                    <span style="font-weight: 700; color: #166534; font-size: 20px;" id="ngoDonAmount"></span>
                </div>
            </div>

            <div id="ngoDonMsgBox" style="display: none; margin-top: 14px;">
                <label class="form-label" style="margin-bottom: 2px;">Donor Message:</label>
                <div id="ngoDonMsg" style="background: #f8fafc; padding: 10px 14px; border-radius: 6px; border: 1px solid #e2e8f0; font-style: italic;"></div>
            </div>

            <div style="background: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; padding: 10px 14px; margin-top: 14px; font-size: 13px; color: #92400e;">
                ℹ️ Final approval authority rests with the GiveAID Platform Administrator. You will be notified once this donation is verified.
            </div>

            <div style="text-align: right; margin-top: 20px;">
                <button type="button" class="btn-secondary-hero" style="padding: 8px 20px;" onclick="$('#ngoDonationModal').fadeOut(200)">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {
            // 1. Program Progress Chart (Raised vs Target)
            var progNames = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ProgramNames));
            var progRaised = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ProgramRaised));
            var progTargets = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ProgramTargets));

            var ctxProg = document.getElementById('ngoProgramsChart').getContext('2d');
            new Chart(ctxProg, {
                type: 'bar',
                data: {
                    labels: progNames,
                    datasets: [
                        {
                            label: 'Amount Raised (PKR)',
                            data: progRaised,
                            backgroundColor: '#2e7d32',
                            borderRadius: 6
                        },
                        {
                            label: 'Target Goal (PKR)',
                            data: progTargets,
                            backgroundColor: '#e0e0e0',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (val) { return 'PKR ' + val; }
                            }
                        }
                    }
                }
            });

            // 2. NGO Monthly Inflow Chart
            var monthlyLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyLabels));
            var monthlyAmounts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyAmounts));

            var ctxMonth = document.getElementById('ngoMonthlyChart').getContext('2d');
            new Chart(ctxMonth, {
                type: 'line',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Donation Inflow (PKR)',
                        data: monthlyAmounts,
                        borderColor: '#2e7d32',
                        backgroundColor: 'rgba(46, 125, 50, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 5,
                        pointBackgroundColor: '#2e7d32'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (val) { return 'PKR ' + val; }
                            }
                        }
                    }
                }
            });
        });

        // Donation Detail View (Read-Only for NGO)
        function viewNgoDonation(donationId) {
            $.getJSON('@Url.Action("GetDonationDetailsJson", "Dashboard")', { id: donationId }, function (d) {
                if (!d || d.error) {
                    alert(d ? d.error : 'Could not load donation details.');
                    return;
                }
                $('#ngoDonTitle').text('Donation from ' + d.DonorName);
                $('#ngoDonRef').text('Ref: ' + d.PaymentReference);
                $('#ngoDonDonor').text(d.DonorName);
                $('#ngoDonEmail').text(d.DonorEmail);
                $('#ngoDonCause').text(d.CauseName);
                $('#ngoDonProgram').text(d.ProgramName || 'General Fund');
                $('#ngoDonPayMethod').text(d.PaymentMethod);
                $('#ngoDonDate').text(d.DonationDate);
                $('#ngoDonAmount').text('PKR ' + parseFloat(d.Amount).toLocaleString());

                var statusHtml = '';
                if (d.Status === 'Approved') {
                    statusHtml = '<span class="status-pill" style="background-color:#dcfce7;color:#166534;">✓ Approved</span>';
                } else if (d.Status === 'Pending') {
                    statusHtml = '<span class="status-pill status-pending">⏳ Pending Admin Approval</span>';
                } else {
                    statusHtml = '<span class="status-pill" style="background-color:#fee2e2;color:#991b1b;">✕ Denied</span>';
                }
                $('#ngoDonStatus').html(statusHtml);

                if (d.Message && d.Message.trim() !== '') {
                    $('#ngoDonMsg').text(d.Message);
                    $('#ngoDonMsgBox').show();
                } else {
                    $('#ngoDonMsgBox').hide();
                }

                $('#ngoDonationModal').fadeIn(200);
            });
        }

        // Close modals on outside click
        $(window).on('click', function(e) {
            if ($(e.target).is('.donation-modal-overlay')) {
                $(e.target).fadeOut(200);
            }
        });
    </script>
}
