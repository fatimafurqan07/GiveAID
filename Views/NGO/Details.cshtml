@model GiveAID_Project.Models.NgoDetailViewModel
@using System
@using System.Linq
@{
    ViewBag.Title = Model.NGOName + " | GiveAID NGO Directory";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string initials = string.Join("", (Model.NGOName ?? "NG").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0, 1))).ToUpperInvariant();
}

@section Styles{
    <style>
        .profile-page {
            background: #f7faf9;
            color: var(--navy);
            overflow: hidden
        }

        .profile-shell {
            max-width: 1160px;
            margin: auto;
            padding-left: 24px;
            padding-right: 24px
        }

        .crumbs {
            padding: 25px 0 18px;
            font-size: 11px;
            color: #6a8084
        }

            .crumbs a {
                color: var(--emerald);
                text-decoration: none
            }

            .crumbs span {
                padding: 0 8px;
                color: #a2b0b2
            }

        .profile-hero {
            padding: 0 0 70px;
            background: linear-gradient(180deg,#fff,#f7faf9)
        }

        .hero-card {
            border-radius: 29px;
            padding: 48px;
            background: radial-gradient(circle at 92% 12%,rgba(240,139,104,.24),transparent 29%),linear-gradient(120deg,#082d3b,#075d53);
            color: #fff;
            box-shadow: 0 28px 65px rgba(7,31,44,.22);
            position: relative;
            overflow: hidden
        }

            .hero-card:after {
                content: "";
                position: absolute;
                width: 280px;
                height: 280px;
                border: 55px solid rgba(255,255,255,.04);
                border-radius: 50%;
                right: -80px;
                bottom: -155px
            }

        .hero-main {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 28px;
            align-items: start;
            position: relative;
            z-index: 1
        }

        .profile-logo {
            width: 108px;
            height: 108px;
            border-radius: 27px;
            background: linear-gradient(135deg,#f08b68,#f3c16e);
            color: #082d3b;
            display: grid;
            place-items: center;
            font-size: 32px;
            font-weight: 900;
            border: 5px solid rgba(255,255,255,.16);
            overflow: hidden;
            box-shadow: 0 16px 35px rgba(0,0,0,.18)
        }

            .profile-logo img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

        .profile-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 15px
        }

        .profile-tag {
            padding: 7px 10px;
            border-radius: 22px;
            background: rgba(255,255,255,.11);
            border: 1px solid rgba(255,255,255,.14);
            color: #c8e6df;
            font-size: 9px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .08em
        }

        .hero-card h1 {
            font-size: 47px;
            line-height: 1.05;
            letter-spacing: -.045em;
            margin: 0 0 13px
        }

        .hero-summary {
            font-size: 14px;
            line-height: 1.75;
            color: #c4dcda;
            max-width: 740px;
            margin: 0
        }

        .contact-row {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            margin-top: 25px
        }

        .contact-link {
            padding: 10px 13px;
            border-radius: 10px;
            background: rgba(255,255,255,.09);
            color: #fff;
            text-decoration: none;
            font-size: 10px;
            border: 1px solid rgba(255,255,255,.12)
        }

            .contact-link:hover {
                background: #fff;
                color: #075449
            }

        .profile-stats {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
            margin-top: 35px;
            position: relative;
            z-index: 1
        }

        .profile-stat {
            padding: 18px;
            border-radius: 16px;
            background: rgba(255,255,255,.075);
            border: 1px solid rgba(255,255,255,.1)
        }

            .profile-stat strong {
                display: block;
                font-size: 23px
            }

            .profile-stat span {
                display: block;
                margin-top: 5px;
                color: #9fc2c1;
                font-size: 8px;
                text-transform: uppercase;
                letter-spacing: .08em
            }

        .profile-content {
            padding: 75px 0 100px;
            background: radial-gradient(circle at 5% 18%,rgba(8,127,91,.08),transparent 27%),radial-gradient(circle at 96% 70%,rgba(240,139,104,.09),transparent 29%),#f7faf9
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1.4fr .6fr;
            gap: 24px;
            align-items: start
        }

        .panel {
            border: 1px solid #d2e5dc;
            border-radius: 23px;
            padding: 34px;
            box-shadow: 0 16px 40px rgba(7,31,44,.09)
        }

        .content-grid .panel:first-child {
            background: linear-gradient(145deg,#e8f7f0,#fbfefd);
            position: relative;
            overflow: hidden
        }

            .content-grid .panel:first-child:after {
                content: "";
                position: absolute;
                width: 180px;
                height: 180px;
                border: 34px solid rgba(8,127,91,.06);
                border-radius: 50%;
                right: -65px;
                bottom: -85px
            }

        .content-grid .panel:last-child {
            background: linear-gradient(145deg,#fff3e9,#fffaf6);
            border-color: #edd9c9
        }

        .panel-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .12em;
            color: var(--coral);
            font-weight: 900
        }

        .panel h2 {
            font-size: 29px;
            letter-spacing: -.035em;
            margin: 11px 0 16px
        }

        .about-copy {
            font-size: 13px;
            line-height: 1.85;
            color: #526f72;
            white-space: pre-line;
            max-width: 90%;
            position: relative;
            z-index: 1
        }

        .info-list {
            display: grid;
            gap: 12px;
            margin-top: 22px
        }

        .info-item {
            padding: 15px;
            border-radius: 13px;
            background: rgba(255,255,255,.72);
            border: 1px solid rgba(227,211,199,.65)
        }

            .info-item span {
                display: block;
                font-size: 8px;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: #728589;
                font-weight: 900
            }

            .info-item strong, .info-item a {
                display: block;
                margin-top: 5px;
                font-size: 11px;
                color: #173f43;
                text-decoration: none;
                overflow-wrap: anywhere
            }

                .info-item a:hover {
                    color: var(--emerald)
                }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 25px;
            margin: 65px 0 0;
            padding: 31px 34px 24px;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb);
            border: 1px solid #d7e7df;
            border-bottom: 0;
            border-radius: 24px 24px 0 0
        }

            .section-head h2 {
                font-size: 35px;
                letter-spacing: -.04em;
                margin: 8px 0 0
            }

            .section-head p {
                max-width: 460px;
                color: #5d777a;
                font-size: 12px;
                line-height: 1.65;
                margin: 0
            }

        .causes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
            gap: 17px;
            padding: 0 34px 34px;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb);
            border: 1px solid #d7e7df;
            border-top: 0;
            border-radius: 0 0 24px 24px
        }

        .cause-card {
            min-height: 225px;
            padding: 28px;
            border-radius: 20px;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(135deg,#087f5b,#0aa878);
            box-shadow: 0 15px 35px rgba(7,31,44,.14);
            position: relative;
            overflow: hidden;
            transition: .3s
        }

            .cause-card:nth-child(2) {
                background: linear-gradient(135deg,#e76f51,#f19a62)
            }

            .cause-card:nth-child(3) {
                background: linear-gradient(135deg,#17667d,#2c929a)
            }

            .cause-card:after {
                content: "";
                position: absolute;
                width: 170px;
                height: 170px;
                border: 32px solid rgba(255,255,255,.08);
                border-radius: 50%;
                right: -55px;
                bottom: -75px
            }

            .cause-card:hover {
                transform: translateY(-7px);
                color: #fff
            }

        .cause-code {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(255,255,255,.16);
            display: grid;
            place-items: center;
            font-size: 10px;
            font-weight: 900
        }

        .cause-card h3 {
            font-size: 21px;
            margin: 25px 0 9px;
            position: relative;
            z-index: 1
        }

        .cause-card p {
            font-size: 11px;
            color: rgba(255,255,255,.84);
            line-height: 1.7;
            position: relative;
            z-index: 1;
            max-width: 75%
        }

        .cause-foot {
            margin-top: 20px;
            font-size: 10px;
            font-weight: 850;
            position: relative;
            z-index: 1
        }

        .program-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
            gap: 19px;
            padding: 0 34px 34px;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb);
            border: 1px solid #d7e7df;
            border-top: 0;
            border-radius: 0 0 24px 24px
        }

        .program-card {
            background: #fff;
            border: 1px solid #d5e4de;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 16px 40px rgba(7,31,44,.11);
            transition: .3s
        }

            .program-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 24px 50px rgba(7,31,44,.17)
            }

            .program-card:only-child {
                display: grid;
                grid-template-columns: .9fr 1.1fr;
                max-width: none
            }

                .program-card:only-child .program-image {
                    height: 100%;
                    min-height: 335px
                }

                .program-card:only-child .program-body {
                    padding: 35px;
                    display: flex;
                    flex-direction: column;
                    justify-content: center
                }

        .program-image {
            height: 190px;
            position: relative;
            background: #0a7058;
            overflow: hidden
        }

            .program-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: .45s
            }

        .program-card:hover .program-image img {
            transform: scale(1.06)
        }

        .program-image:after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg,transparent 45%,rgba(7,31,44,.7))
        }

        .program-status {
            position: absolute;
            z-index: 2;
            top: 15px;
            left: 15px;
            padding: 7px 10px;
            border-radius: 20px;
            background: rgba(7,31,44,.7);
            color: #fff;
            font-size: 8px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .08em
        }

        .program-body {
            padding: 24px
        }

        .program-cause {
            font-size: 9px;
            color: var(--emerald);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .08em
        }

        .program-body h3 {
            font-size: 20px;
            line-height: 1.35;
            margin: 9px 0
        }

        .program-body p {
            font-size: 11px;
            line-height: 1.7;
            color: #687d81;
            min-height: 55px
        }

        .progress-track {
            height: 8px;
            background: #e7efec;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 17px
        }

            .progress-track i {
                display: block;
                height: 100%;
                background: linear-gradient(90deg,#087f5b,#42c892)
            }

        .progress-row {
            display: flex;
            justify-content: space-between;
            margin-top: 9px;
            font-size: 9px;
            color: #718488
        }

        .program-location {
            margin-top: 17px;
            padding-top: 14px;
            border-top: 1px solid #e7eeeb;
            font-size: 10px;
            color: #567075
        }

        .empty {
            padding: 45px;
            text-align: center;
            background: #fff;
            border: 1px dashed #bdd0c8;
            border-radius: 20px;
            color: #6b8084
        }

        .section-head + .empty {
            border-radius: 0 0 24px 24px;
            border: 1px solid #d7e7df;
            border-top: 0;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb)
        }

        .back-cta {
            margin-top: 75px;
            padding: 38px;
            border-radius: 24px;
            background: linear-gradient(110deg,#f08b68,#f0b967);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
            color: #082d3b
        }

            .back-cta h2 {
                font-size: 27px;
                margin: 0 0 7px
            }

            .back-cta p {
                margin: 0;
                color: #5c5048;
                font-size: 12px
            }

        .back-btn {
            padding: 12px 16px;
            border-radius: 10px;
            background: #082d3b;
            color: #fff;
            text-decoration: none;
            font-size: 11px;
            font-weight: 850
        }

            .back-btn:hover {
                background: #087f5b;
                color: #fff
            }

        .reveal {
            opacity: 0;
            transform: translateY(25px);
            transition: .7s
        }

            .reveal.show {
                opacity: 1;
                transform: none
            }

        @@media(max-width:920px) {
            .content-grid {
                grid-template-columns: 1fr
            }

            .program-grid, .causes-grid {
                grid-template-columns: 1fr 1fr
            }

            .profile-stats {
                grid-template-columns: 1fr 1fr
            }
        }

        @@media(max-width:620px) {
            .profile-shell {
                padding-left: 16px;
                padding-right: 16px
            }

            .hero-card {
                padding: 30px
            }

            .hero-main {
                grid-template-columns: 1fr
            }

            .hero-card h1 {
                font-size: 37px
            }

            .profile-stats, .program-grid, .causes-grid {
                grid-template-columns: 1fr
            }

            .profile-content {
                padding: 55px 0 75px
            }

            .section-head, .back-cta {
                display: block
            }

                .section-head p {
                    margin-top: 12px
                }

            .program-card:only-child {
                display: block
            }

                .program-card:only-child .program-image {
                    min-height: 230px
                }

            .causes-grid, .program-grid {
                padding: 0 18px 18px
            }

            .section-head {
                padding: 25px 18px 20px
            }

            .back-btn {
                display: inline-block;
                margin-top: 20px
            }
        }

        @@media(prefers-reduced-motion:reduce) {
            .reveal {
                opacity: 1;
                transform: none
            }

            .program-card, .cause-card {
                transition: none
            }
        }
    </style>
}

<main class="profile-page">
    <div class="profile-shell"><nav class="crumbs"><a href="@Url.Action("Index","Home")">Home</a><span>/</span><a href="@Url.Action("Index","NGO")">NGOs</a><span>/</span>@Model.NGOName</nav></div>
    <section class="profile-hero">
        <div class="profile-shell">
            <div class="hero-card">
                <div class="hero-main"><div class="profile-logo">@if (!string.IsNullOrWhiteSpace(Model.LogoURL))
                {<img src="@Model.LogoURL" alt="@Model.NGOName logo" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" /><span style="display:none">@initials</span>}
            else
            {@initials}</div><div><div class="profile-tags"><span class="profile-tag">Associated NGO</span>@if (!string.IsNullOrWhiteSpace(Model.Category))
                {<span class="profile-tag">@Model.Category</span>}<span class="profile-tag">@(string.IsNullOrWhiteSpace(Model.City)?"Pakistan":Model.City)</span></div><h1>@Model.NGOName</h1><p class="hero-summary">@(string.IsNullOrWhiteSpace(Model.Description)?"Community-focused organisation connected to causes and programmes maintained on GiveAID.":Model.Description)</p><div class="contact-row">@if (!string.IsNullOrWhiteSpace(Model.Email))
                {<a class="contact-link" href="mailto:@Model.Email">Email organisation</a>}@if (!string.IsNullOrWhiteSpace(Model.Phone))
                {<a class="contact-link" href="tel:@Model.Phone">@Model.Phone</a>}@if (!string.IsNullOrWhiteSpace(Model.WebsiteURL))
                {<a class="contact-link" href="@Model.WebsiteURL" target="_blank" rel="noopener noreferrer">Official website</a>}</div></div></div>
                <div class="profile-stats"><div class="profile-stat"><strong>@Model.TotalProgramsCount</strong><span>Programmes</span></div><div class="profile-stat"><strong>@Model.TotalCausesCount</strong><span>Connected causes</span></div><div class="profile-stat"><strong>@Model.TotalDonationsCount</strong><span>Completed records</span></div><div class="profile-stat"><strong>PKR @Model.TotalFundsRaised.ToString("N0")</strong><span>Completed contributions</span></div></div>
            </div>
        </div>
    </section>

    <section class="profile-content">
        <div class="profile-shell">
            <div class="content-grid reveal"><article class="panel"><div class="panel-label">Organisation profile</div><h2>About @Model.NGOName</h2><div class="about-copy">@(string.IsNullOrWhiteSpace(Model.Description)?"No additional organisation description is currently available.":Model.Description)</div></article><aside class="panel"><div class="panel-label">Directory information</div><h2>Contact details</h2><div class="info-list">@if (!string.IsNullOrWhiteSpace(Model.Address))
            {<div class="info-item"><span>Address</span><strong>@Model.Address</strong></div>}<div class="info-item"><span>Location</span><strong>@Model.City, @Model.Country</strong></div>@if (!string.IsNullOrWhiteSpace(Model.RegistrationNumber))
            {<div class="info-item"><span>Registration record</span><strong>@Model.RegistrationNumber</strong></div>}<div class="info-item"><span>Added to GiveAID</span><strong>@Model.CreatedAt.ToString("MMMM yyyy")</strong></div></div></aside></div>

            <div class="section-head reveal"><div><div class="panel-label">Areas of work</div><h2>Connected causes</h2></div><p>Causes are connected through active or upcoming programmes maintained in the database.</p></div>
            @if (Model.Causes != null && Model.Causes.Any())
            {<div class="causes-grid reveal">@foreach (var cause in Model.Causes)
                {
                    string code = (cause.CauseName ?? "C").Length > 1 ? cause.CauseName.Substring(0, 2).ToUpperInvariant() : cause.CauseName.ToUpperInvariant();<a class="cause-card" href="@Url.Action("Details","Causes",new{id=cause.CauseID})"><div class="cause-code">@code</div><h3>@cause.CauseName</h3><p>@cause.Description</p><div class="cause-foot">@cause.ProgramsCount programme(s)</div></a>}</div>}
        else
        {<div class="empty reveal">No causes are connected to this NGO yet.</div>}

            <div class="section-head reveal"><div><div class="panel-label">Current initiatives</div><h2>Programmes by this NGO</h2></div><p>Funding figures below are calculated from completed demonstration donation records.</p></div>
            @if (Model.Programs != null && Model.Programs.Any())
            {<div class="program-grid reveal">@foreach (var p in Model.Programs)
                {
                    string key = (p.CauseName ?? "").ToLowerInvariant(); string fallback = key.Contains("water") ? "programme-water.png" : key.Contains("health") ? "programme-health.png" : "programme-learning.png"; string image = string.IsNullOrWhiteSpace(p.ImageURL) ? Url.Content("~/Content/" + fallback) : p.ImageURL; string copy = string.IsNullOrWhiteSpace(p.Description) ? "Programme information maintained by the platform administrator." : p.Description; if (copy.Length > 135) { copy = copy.Substring(0, 135) + "..."; }<article class="program-card"><div class="program-image"><img src="@image" alt="@p.ProgramName" /><span class="program-status">@p.Status</span></div><div class="program-body"><div class="program-cause">@p.CauseName</div><h3>@p.ProgramName</h3><p>@copy</p><div class="progress-track"><i style="width:@p.ProgressPercent%"></i></div><div class="progress-row"><span>PKR @p.CurrentAmount.ToString("N0")</span><span>@p.ProgressPercent% of @p.TargetAmount.ToString("N0")</span></div><div class="program-location">@p.Location &nbsp; | &nbsp; @p.InterestedCount interested</div></div></article>}</div>}
        else
        {<div class="empty reveal">No active or upcoming programmes are available for this NGO.</div>}

            <div class="back-cta reveal"><div><h2>Continue exploring the directory.</h2><p>Compare organisations and discover more community programmes on GiveAID.</p></div><a class="back-btn" href="@(Url.Action("Index","NGO") + "#directoryFilters")">Back to NGO directory</a></div>
        </div>
    </section>
</main>

@section Scripts{
    <script>(function () { var items = document.querySelectorAll('.reveal'); if ('IntersectionObserver' in window) { var observer = new IntersectionObserver(function (entries) { entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('show'); observer.unobserve(entry.target); } }); }, { threshold: .1 }); items.forEach(function (item) { observer.observe(item); }); } else { items.forEach(function (item) { item.classList.add('show'); }); } })();</script>
}
