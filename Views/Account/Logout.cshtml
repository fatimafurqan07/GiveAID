@{
    ViewBag.Title = "Logged Out";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-container">
    <div class="auth-card logout-card text-center">
        <div class="auth-header">
            <div class="auth-icon">👋</div>
            <h2>You Have Been Logged Out</h2>
            <p>Thank you for using Give-AID. Your session has been safely closed.</p>
        </div>

        <div class="logout-actions">
            <a href="@Url.Action("Login", "Account")" class="auth-btn">
                Log In Again
            </a>

            <a href="@Url.Action("Index", "Home")" class="btn-secondary-link">
                Return to Homepage
            </a>
        </div>
    </div>
</div>
