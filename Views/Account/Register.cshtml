@model GiveAID_Project.Models.RegisterModel

@{
    ViewBag.Title = "Create an Account";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-container">
    <div class="auth-card register-card">
        <div class="auth-header">
            <div class="auth-icon">🤝</div>
            <h2>Join Give-AID</h2>
            <p>Create your account to start donating, volunteering, and making a real difference.</p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form", role = "form" }))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
            {
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
            }

            <div class="form-group">
                @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "e.g. John Doe", autocomplete = "name", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@example.com", type = "email", autocomplete = "email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-row">
                <div class="form-group col-half">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Minimum 6 characters", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group col-half">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Re-enter password", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-half">
                    @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "e.g. +1 555-0199", autocomplete = "tel" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-validation-error" })
                </div>

                <div class="form-group col-half">
                    @Html.LabelFor(m => m.City, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "e.g. New York", autocomplete = "address-level2" })
                    @Html.ValidationMessageFor(m => m.City, "", new { @class = "field-validation-error" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Street address (optional)", autocomplete = "street-address" })
                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error" })
            </div>

            <button type="submit" class="auth-btn">
                Create Account
            </button>
        }

        <div class="auth-footer">
            <p>Already have an account? <a href="@Url.Action("Login", "Account")">Log in here</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Optional UX enhancement for form submission feedback
            $('form.auth-form').on('submit', function () {
                if ($(this).valid()) {
                    $(this).find('button[type="submit"]').prop('disabled', true).text('Creating Account...');
                }
            });
        });
    </script>
}
