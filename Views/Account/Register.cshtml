@model GiveAID_Project.Models.RegisterModel
@{ViewBag.Title = "Create account | GiveAID"; Layout = "~/Views/Shared/_Layout.cshtml";}
@section Styles{
    <style>
        .reg-page {
            padding: 38px 22px 55px;
            background: radial-gradient(circle at 90% 8%,#dff7eb,transparent 34%),linear-gradient(135deg,#fffaf2,#f4fbf8)
        }

        .reg-shell {
            max-width: 1040px;
            margin: auto;
            display: grid;
            grid-template-columns: .72fr 1.28fr;
            border: 1px solid #aecdc1;
            border-radius: 26px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(7,31,44,.16)
        }

        .reg-side {
            padding: 38px;
            background: linear-gradient(155deg,#07303e,#076256);
            color: #fff;
            position: relative;
            overflow: hidden
        }

            .reg-side:after {
                content: "";
                position: absolute;
                width: 230px;
                height: 230px;
                border: 38px solid rgba(255,255,255,.055);
                border-radius: 50%;
                left: -120px;
                bottom: -120px
            }

        .badge {
            display: inline-flex;
            padding: 8px 12px;
            border-radius: 25px;
            background: rgba(255,255,255,.09);
            font-size: 8px;
            font-weight: 900;
            letter-spacing: .11em;
            text-transform: uppercase;
            color: #78e6c0
        }

        .reg-side h1 {
            font-size: 37px;
            line-height: 1.06;
            letter-spacing: -.05em;
            margin: 22px 0 13px
        }

        .reg-side p {
            color: #bad0d1;
            line-height: 1.7;
            font-size: 11px
        }

        .role-note {
            margin-top: 25px;
            padding: 16px;
            border-radius: 14px;
            background: rgba(255,255,255,.075);
            border: 1px solid rgba(255,255,255,.12);
            position: relative;
            z-index: 2
        }

            .role-note strong {
                display: block;
                font-size: 11px
            }

            .role-note span {
                display: block;
                margin-top: 6px;
                color: #c4d7d8;
                font-size: 9px;
                line-height: 1.6
            }

        .reg-card {
            padding: 32px 38px 30px;
            background: linear-gradient(145deg,#fffaf3,#eef9f5)
        }

        .eyebrow {
            font-size: 8px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .13em;
            color: #ef7658
        }

        .reg-card h2 {
            font-size: 31px;
            letter-spacing: -.045em;
            margin: 7px 0 4px
        }

        .intro {
            color: #637a7e;
            font-size: 10px;
            line-height: 1.55
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 11px 14px
        }

        .field {
            margin-top: 11px
        }

        .full {
            grid-column: 1/3
        }

        .field label {
            display: block;
            font-size: 8px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #173e45;
            margin-bottom: 6px
        }

        .control {
            width: 100%;
            height: 49px;
            border: 1px solid #9fc2b5;
            border-radius: 11px;
            background: #fff;
            padding: 0 13px;
            font: inherit;
            font-size: 11px;
            box-sizing: border-box;
            outline: none;
            box-shadow: 0 4px 12px rgba(7,31,44,.03)
        }

            .control:focus {
                border-color: #078b66;
                box-shadow: 0 0 0 3px rgba(7,139,102,.1)
            }

        .password-wrap {
            position: relative
        }

            .password-wrap .control {
                padding-right: 48px
            }

        .eye-btn {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 37px;
            height: 37px;
            border: 0;
            border-radius: 9px;
            background: #edf6f2;
            color: #1b4c51;
            display: grid;
            place-items: center;
            cursor: pointer
        }

            .eye-btn:hover {
                background: #dff0e9
            }

            .eye-btn svg {
                width: 18px;
                height: 18px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.8
            }

        .password-note {
            margin-top: 6px;
            color: #60787c;
            font-size: 7.5px;
            line-height: 1.45
        }

        .submit {
            margin-top: 16px;
            width: 100%;
            height: 50px;
            border: 0;
            border-radius: 11px;
            background: #087f5b;
            color: #fff;
            font: inherit;
            font-size: 10px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 11px 22px rgba(8,127,91,.21)
        }

            .submit:hover {
                background: #066f50
            }

        .validation-summary-errors {
            margin-top: 12px;
            padding: 11px 13px;
            background: #fff0ec;
            border: 1px solid #efb7a9;
            color: #9b3c29;
            border-radius: 10px;
            font-size: 9px
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 15px
            }

        .field-validation-error {
            display: block;
            color: #b14834;
            font-size: 8px;
            margin-top: 4px
        }

        .footer {
            text-align: center;
            margin-top: 13px;
            color: #647b7f;
            font-size: 9px
        }

            .footer a {
                color: #087457;
                text-decoration: none;
                font-weight: 900
            }

        @@media(max-width:820px) {
            .reg-shell {
                grid-template-columns: 1fr
            }

            .reg-side {
                padding: 32px
            }

            .reg-card {
                padding: 32px
            }
        }

        @@media(max-width:560px) {
            .reg-page {
                padding: 28px 13px
            }

            .grid {
                grid-template-columns: 1fr
            }

            .full {
                grid-column: auto
            }

            .reg-card {
                padding: 27px 20px
            }

            .reg-side h1 {
                font-size: 33px
            }
        }
    </style>
}
<main class="reg-page"><div class="reg-shell"><aside class="reg-side"><span class="badge">User registration</span><h1>Join GiveAID.</h1><p>Create a personal account for participation features and your user dashboard.</p><div class="role-note"><strong>User accounts only</strong><span>NGO records are maintained by the administrator. Public registration receives the User role.</span></div></aside><section class="reg-card"><span class="eyebrow">Get started</span><h2>Create your account</h2><p class="intro">Required account details first; profile information is optional.</p>@if (!ViewData.ModelState.IsValid)
{@Html.ValidationSummary(true)}@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @id = "registerForm" }))
{@Html.AntiForgeryToken()<div class="grid"><div class="field">@Html.LabelFor(m => m.FullName)@Html.TextBoxFor(m => m.FullName, new { @class = "control", maxlength = "150", autocomplete = "name", placeholder = "Your full name" })@Html.ValidationMessageFor(m => m.FullName)</div><div class="field">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { @class = "control", type = "email", maxlength = "256", autocomplete = "email", placeholder = "name@example.com" })@Html.ValidationMessageFor(m => m.Email)</div><div class="field">@Html.LabelFor(m => m.Password)<div class="password-wrap">@Html.PasswordFor(m => m.Password, new { @class = "control", maxlength = "100", autocomplete = "new-password", placeholder = "Strong password", id = "registerPassword" })<button class="eye-btn" type="button" data-password="registerPassword" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.7" /></svg></button></div>@Html.ValidationMessageFor(m => m.Password)<div class="password-note">10+ characters: uppercase, lowercase, number and special character.</div></div><div class="field">@Html.LabelFor(m => m.ConfirmPassword)<div class="password-wrap">@Html.PasswordFor(m => m.ConfirmPassword, new { @class = "control", maxlength = "100", autocomplete = "new-password", placeholder = "Repeat password", id = "confirmPassword" })<button class="eye-btn" type="button" data-password="confirmPassword" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.7" /></svg></button></div>@Html.ValidationMessageFor(m => m.ConfirmPassword)</div><div class="field">@Html.LabelFor(m => m.Phone)@Html.TextBoxFor(m => m.Phone, new { @class = "control", maxlength = "30", autocomplete = "tel", placeholder = "Optional" })@Html.ValidationMessageFor(m => m.Phone)</div><div class="field">@Html.LabelFor(m => m.City)@Html.TextBoxFor(m => m.City, new { @class = "control", maxlength = "100", autocomplete = "address-level2", placeholder = "Optional" })@Html.ValidationMessageFor(m => m.City)</div><div class="field full">@Html.LabelFor(m => m.Address)@Html.TextBoxFor(m => m.Address, new { @class = "control", maxlength = "500", autocomplete = "street-address", placeholder = "Optional street address" })@Html.ValidationMessageFor(m => m.Address)</div></div><button id="registerButton" class="submit" type="submit">Create user account&nbsp; &#8594;</button>}<div class="footer">Already registered? <a href="@Url.Action("Login","Account")">Sign in</a></div></section></div></main>
@section Scripts{
    <script>(function () { document.querySelectorAll('.eye-btn').forEach(function (btn) { btn.addEventListener('click', function () { var input = document.getElementById(btn.getAttribute('data-password')), show = input.type === 'password'; input.type = show ? 'text' : 'password'; btn.setAttribute('aria-pressed', show ? 'true' : 'false'); btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password'); }); }); var f = document.getElementById('registerForm'), b = document.getElementById('registerButton'); if (f) f.addEventListener('submit', function () { if (f.checkValidity()) { b.disabled = true; b.textContent = 'Creating account...'; } }); })();</script>
}
