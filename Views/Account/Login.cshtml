@model GiveAID_Project.Models.LoginModel

@{
    ViewBag.Title = "Log In";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-container">
    <div class="auth-card login-card">
        <div class="auth-header">
            <div class="auth-icon">🔐</div>
            <h2>Welcome Back</h2>
            <p>Sign in to your Give-AID account to manage donations, view programs, and support causes.</p>
        </div>

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)

            if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
            {
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
            }

            <div class="form-group">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "name@example.com", type = "email", autocomplete = "email", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-options">
                <label class="checkbox-container">
                    @Html.CheckBoxFor(m => m.RememberMe)
                    <span>Remember me on this device</span>
                </label>
            </div>

            <button type="submit" class="auth-btn">
                Sign In
            </button>
        }

        <div class="auth-footer">
            <p>Don't have an account yet? <a href="@Url.Action("Register", "Account")">Create an account</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('form.auth-form').on('submit', function () {
                if ($(this).valid()) {
                    $(this).find('button[type="submit"]').prop('disabled', true).text('Signing In...');
                }
            });
        });
    </script>
}
