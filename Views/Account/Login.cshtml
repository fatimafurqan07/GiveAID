@model GiveAID_Project.Models.LoginModel
@{ViewBag.Title = "Sign in | GiveAID"; Layout = "~/Views/Shared/_Layout.cshtml";}
@section Styles{
    <style>
        .auth-page {
            min-height: calc(100vh - 75px);
            padding: 62px 24px;
            background: radial-gradient(circle at 8% 8%,#d9f6e8,transparent 35%),linear-gradient(135deg,#fffaf2,#f4fbf8);
            display: grid;
            place-items: center
        }

        .auth-shell {
            width: min(1120px,100%);
            display: grid;
            grid-template-columns: .92fr 1.08fr;
            border: 1px solid #aecdc1;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 30px 78px rgba(7,31,44,.2)
        }

        .auth-story {
            padding: 58px;
            background: linear-gradient(150deg,#062d3b,#076155);
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 610px;
            position: relative;
            overflow: hidden
        }

            .auth-story:after {
                content: "";
                position: absolute;
                width: 310px;
                height: 310px;
                border: 48px solid rgba(255,255,255,.06);
                border-radius: 50%;
                right: -120px;
                bottom: -125px
            }

        .brand-chip {
            display: inline-flex;
            width: max-content;
            padding: 9px 13px;
            border-radius: 30px;
            background: rgba(255,255,255,.09);
            border: 1px solid rgba(255,255,255,.13);
            font-size: 9px;
            font-weight: 900;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: #78e6c0
        }

        .auth-story h1 {
            font-size: 48px;
            line-height: 1.04;
            letter-spacing: -.055em;
            margin: 27px 0 17px
        }

        .auth-story p {
            color: #b6cecf;
            line-height: 1.8;
            font-size: 13px;
            max-width: 390px
        }

        .trust-list {
            display: grid;
            gap: 11px;
            position: relative;
            z-index: 2
        }

        .trust-item {
            padding: 16px;
            border-radius: 14px;
            background: rgba(255,255,255,.075);
            border: 1px solid rgba(255,255,255,.07);
            font-size: 10px;
            color: #d1e2e2
        }

        .auth-card {
            padding: 62px;
            background: linear-gradient(145deg,#fffaf3,#eef9f5);
            display: flex;
            flex-direction: column;
            justify-content: center
        }

        .eyebrow {
            font-size: 9px;
            font-weight: 900;
            letter-spacing: .13em;
            text-transform: uppercase;
            color: #ef7658
        }

        .auth-card h2 {
            font-size: 39px;
            letter-spacing: -.05em;
            margin: 12px 0 9px
        }

        .intro {
            color: #637a7e;
            font-size: 13px;
            line-height: 1.7;
            margin-bottom: 27px
        }

        .field {
            margin-top: 19px
        }

            .field label {
                display: block;
                font-size: 9px;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: #173e45;
                margin-bottom: 8px
            }

        .control {
            width: 100%;
            height: 59px;
            border: 1px solid #9fc2b5;
            border-radius: 14px;
            background: #fff;
            padding: 0 17px;
            font: inherit;
            font-size: 13px;
            box-sizing: border-box;
            outline: none;
            box-shadow: 0 5px 15px rgba(7,31,44,.035)
        }

            .control:focus {
                border-color: #078b66;
                box-shadow: 0 0 0 4px rgba(7,139,102,.1)
            }

        .password-wrap {
            position: relative
        }

            .password-wrap .control {
                padding-right: 56px
            }

        .eye-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 42px;
            height: 42px;
            border: 0;
            border-radius: 10px;
            background: #edf6f2;
            color: #1b4c51;
            display: grid;
            place-items: center;
            cursor: pointer
        }

            .eye-btn:hover {
                background: #dff0e9
            }

            .eye-btn svg {
                width: 20px;
                height: 20px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.8
            }

        .check {
            display: flex;
            gap: 9px;
            align-items: center;
            margin: 20px 0;
            color: #536c70;
            font-size: 11px
        }

            .check input {
                width: 16px;
                height: 16px;
                accent-color: #087f5b
            }

        .submit {
            width: 100%;
            height: 59px;
            border: 0;
            border-radius: 14px;
            background: #087f5b;
            color: #fff;
            font: inherit;
            font-size: 12px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 14px 28px rgba(8,127,91,.24)
        }

            .submit:hover {
                background: #066f50
            }

            .submit:disabled {
                opacity: .65
            }

        .validation-summary-errors {
            padding: 15px 17px;
            background: #fff0ec;
            border: 1px solid #efb7a9;
            color: #9b3c29;
            border-radius: 13px;
            font-size: 10px
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 17px
            }

        .field-validation-error {
            display: block;
            color: #b14834;
            font-size: 9px;
            margin-top: 6px
        }

        .auth-footer {
            text-align: center;
            margin-top: 24px;
            font-size: 11px;
            color: #637a7e
        }

            .auth-footer a {
                color: #087457;
                font-weight: 900;
                text-decoration: none
            }

        @@media(max-width:780px) {
            .auth-shell {
                grid-template-columns: 1fr
            }

            .auth-story {
                min-height: 390px
            }

            .auth-card {
                padding: 44px 30px
            }
        }

        @@media(max-width:480px) {
            .auth-page {
                padding: 35px 14px
            }

            .auth-story {
                padding: 34px
            }

                .auth-story h1 {
                    font-size: 37px
                }

            .auth-card {
                padding: 34px 22px
            }
        }
    </style>
}
<main class="auth-page"><div class="auth-shell"><section class="auth-story"><div><span class="brand-chip">Registered access</span><h1>Welcome back to GiveAID.</h1><p>Sign in to reach the dashboard assigned to your database role and continue from one focused workspace.</p></div><div class="trust-list"><div class="trust-item">Role-based Admin and User routing</div><div class="trust-item">Password verified using a salted hash</div><div class="trust-item">Protected dashboard actions</div></div></section><section class="auth-card"><span class="eyebrow">Account access</span><h2>Sign in</h2><p class="intro">Enter the email and password connected to your GiveAID account.</p>@if (!ViewData.ModelState.IsValid)
{@Html.ValidationSummary(true)}@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @id = "loginForm" }))
{@Html.AntiForgeryToken()@Html.HiddenFor(m => m.ReturnUrl)<div class="field">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { @class = "control", type = "email", maxlength = "256", autocomplete = "email", placeholder = "name@example.com" })@Html.ValidationMessageFor(m => m.Email)</div><div class="field">@Html.LabelFor(m => m.Password)<div class="password-wrap">@Html.PasswordFor(m => m.Password, new { @class = "control", autocomplete = "current-password", placeholder = "Your password", id = "loginPassword" })<button class="eye-btn" type="button" data-password="loginPassword" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.7" /></svg></button></div>@Html.ValidationMessageFor(m => m.Password)</div><label class="check">@Html.CheckBoxFor(m => m.RememberMe)<span>Keep me signed in on this device</span></label><button id="loginButton" class="submit" type="submit">Sign in&nbsp; &#8594;</button>}<div class="auth-footer">New to GiveAID? <a href="@Url.Action("Register","Account")">Create a user account</a></div></section></div></main>
@section Scripts{
    <script>(function () { document.querySelectorAll('.eye-btn').forEach(function (btn) { btn.addEventListener('click', function () { var input = document.getElementById(btn.getAttribute('data-password')), show = input.type === 'password'; input.type = show ? 'text' : 'password'; btn.setAttribute('aria-pressed', show ? 'true' : 'false'); btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password'); }); }); var f = document.getElementById('loginForm'), b = document.getElementById('loginButton'); if (f) f.addEventListener('submit', function () { if (f.checkValidity()) { b.disabled = true; b.textContent = 'Signing in...'; } }); })();</script>
}
