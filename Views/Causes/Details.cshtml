@model GiveAID_Project.Models.CauseDetailViewModel
@using System
@using System.Linq
@{ViewBag.Title = Model.CauseName + " | GiveAID Causes"; Layout = "~/Views/Shared/_Layout.cshtml"; string key = (Model.CauseName ?? "").ToLowerInvariant(); string fallback = key.Contains("water") ? "programme-water.png" : key.Contains("health") ? "programme-health.png" : "programme-learning.png"; string hero = string.IsNullOrWhiteSpace(Model.ImageURL) ? Url.Content("~/Content/" + fallback) : Model.ImageURL; string code = (Model.CauseName ?? "C").Length > 1 ? Model.CauseName.Substring(0, 2).ToUpperInvariant() : "C";}
@section Styles{
    <style>
        .detail-page {
            background: #f7faf9;
            color: var(--navy);
            overflow: hidden
        }

        .shell {
            max-width: 1160px;
            margin: auto;
            padding: 0 24px
        }

        .crumbs {
            padding: 24px 0 17px;
            font-size: 11px;
            color: #6b8084
        }

            .crumbs a {
                color: var(--emerald);
                text-decoration: none
            }

            .crumbs span {
                padding: 0 8px;
                color: #9aabad
            }

        .hero {
            padding-bottom: 70px;
            background: linear-gradient(180deg,#fff,#f7faf9)
        }

        .hero-card {
            height: 510px;
            border-radius: 30px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 28px 65px rgba(7,31,44,.22)
        }

            .hero-card > img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

            .hero-card:after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg,rgba(7,31,44,.94) 0,rgba(7,31,44,.76) 48%,rgba(7,31,44,.15) 100%)
            }

        .hero-copy {
            position: absolute;
            z-index: 2;
            left: 50px;
            top: 50%;
            transform: translateY(-50%);
            max-width: 590px;
            color: #fff
        }

        .hero-tag {
            display: inline-flex;
            padding: 8px 11px;
            border-radius: 20px;
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.18);
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .1em;
            font-weight: 900
        }

        .hero h1 {
            font-size: 52px;
            line-height: 1.03;
            letter-spacing: -.05em;
            margin: 20px 0 14px
        }

        .hero-copy p {
            font-size: 14px;
            line-height: 1.8;
            color: #c7dedd
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 10px;
            margin-top: 28px
        }

        .stat {
            padding: 15px;
            border-radius: 14px;
            background: rgba(255,255,255,.09);
            border: 1px solid rgba(255,255,255,.1)
        }

            .stat strong {
                display: block;
                font-size: 20px
            }

            .stat span {
                font-size: 8px;
                color: #a9c8c6;
                text-transform: uppercase
            }

        .content {
            padding: 75px 0 100px;
            background: radial-gradient(circle at 4% 20%,rgba(8,127,91,.08),transparent 26%),radial-gradient(circle at 96% 75%,rgba(240,139,104,.09),transparent 28%),#f7faf9
        }

        .about {
            display: grid;
            grid-template-columns: 1.25fr .75fr;
            gap: 22px;
            align-items: start
        }

        .panel {
            border-radius: 23px;
            padding: 34px;
            border: 1px solid #d4e5dd;
            box-shadow: 0 15px 39px rgba(7,31,44,.08)
        }

        .about .panel:first-child {
            background: linear-gradient(145deg,#e7f7ef,#fbfefd)
        }

        .about .panel:last-child {
            background: linear-gradient(145deg,#fff2e8,#fffaf6);
            border-color: #edd8c7
        }

        .label {
            font-size: 9px;
            color: var(--coral);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .12em
        }

        .panel h2 {
            font-size: 29px;
            margin: 10px 0 15px
        }

        .panel p {
            font-size: 13px;
            line-height: 1.85;
            color: #587276
        }

        .progress-box {
            margin-top: 23px
        }

        .track {
            height: 10px;
            background: #e1ebe7;
            border-radius: 20px;
            overflow: hidden
        }

            .track i {
                display: block;
                height: 100%;
                background: linear-gradient(90deg,#087f5b,#3fc78f)
            }

        .progress-row {
            display: flex;
            justify-content: space-between;
            margin-top: 9px;
            font-size: 9px;
            color: #60777b
        }

        .fact {
            padding: 14px;
            border-radius: 13px;
            background: rgba(255,255,255,.72);
            margin-top: 10px
        }

            .fact span {
                display: block;
                font-size: 8px;
                text-transform: uppercase;
                color: #73878a
            }

            .fact strong {
                display: block;
                margin-top: 4px;
                font-size: 12px
            }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 25px;
            margin: 65px 0 0;
            padding: 30px 32px 23px;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb);
            border: 1px solid #d7e7df;
            border-bottom: 0;
            border-radius: 24px 24px 0 0
        }

            .section-head h2 {
                font-size: 34px;
                margin: 8px 0 0;
                letter-spacing: -.04em
            }

            .section-head p {
                max-width: 450px;
                font-size: 11px;
                line-height: 1.7;
                color: #5d777a
            }

        .ngo-grid, .program-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(285px,1fr));
            gap: 18px;
            padding: 0 32px 32px;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb);
            border: 1px solid #d7e7df;
            border-top: 0;
            border-radius: 0 0 24px 24px
        }

        .ngo-card {
            background: #fff;
            border: 1px solid #d5e4de;
            border-radius: 20px;
            padding: 23px;
            box-shadow: 0 14px 35px rgba(7,31,44,.09);
            text-decoration: none;
            color: var(--navy);
            transition: .3s
        }

            .ngo-card:hover {
                transform: translateY(-7px);
                color: var(--navy)
            }

        .ngo-top {
            display: flex;
            gap: 14px;
            align-items: center
        }

        .logo {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            background: linear-gradient(135deg,#082d3b,#087f5b);
            color: #fff;
            display: grid;
            place-items: center;
            font-weight: 900;
            overflow: hidden
        }

            .logo img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

        .ngo-card h3 {
            font-size: 17px;
            margin: 0 0 4px
        }

        .ngo-card small {
            color: #6a8084
        }

        .ngo-card p {
            font-size: 10px;
            line-height: 1.65;
            color: #687d81;
            margin: 16px 0
        }

        .ngo-meta {
            display: flex;
            justify-content: space-between;
            padding-top: 13px;
            border-top: 1px solid #e6eeeb;
            font-size: 9px;
            color: #557075
        }

        .program-card {
            background: #fff;
            border: 1px solid #d5e4de;
            border-radius: 21px;
            overflow: hidden;
            box-shadow: 0 15px 38px rgba(7,31,44,.1);
            transition: .3s
        }

            .program-card:hover {
                transform: translateY(-8px)
            }

        .program-image {
            height: 185px;
            position: relative;
            overflow: hidden
        }

            .program-image img {
                width: 100%;
                height: 100%;
                object-fit: cover
            }

        .program-status {
            position: absolute;
            top: 14px;
            left: 14px;
            padding: 7px 9px;
            border-radius: 18px;
            background: rgba(7,31,44,.75);
            color: #fff;
            font-size: 8px;
            font-weight: 900
        }

        .program-body {
            padding: 23px
        }

            .program-body h3 {
                font-size: 19px;
                margin: 0 0 6px
            }

        .program-ngo {
            font-size: 9px;
            color: var(--emerald);
            font-weight: 900
        }

        .program-body p {
            font-size: 10px;
            line-height: 1.65;
            color: #687d81;
            min-height: 50px
        }

        .program-actions {
            display: flex;
            gap: 9px;
            margin-top: 17px
        }

            .program-actions a, .program-actions button {
                min-height: 40px;
                padding: 0 14px;
                border-radius: 10px;
                border: 1px solid #cfe0da;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font: inherit;
                font-size: 9px;
                font-weight: 900;
                text-decoration: none;
                cursor: pointer
            }

            .program-actions a {
                background: #087f5b;
                color: #fff
            }

            .program-actions button {
                background: #eef8f4;
                color: #087457
            }

            .program-actions form {
                margin: 0
            }

        .empty {
            padding: 45px;
            text-align: center;
            background: linear-gradient(120deg,#e6f6ef,#fff7eb);
            border: 1px solid #d7e7df;
            border-top: 0;
            border-radius: 0 0 24px 24px
        }

        .cta {
            margin-top: 70px;
            padding: 38px;
            border-radius: 24px;
            background: linear-gradient(110deg,#087f5b,#075a53);
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center
        }

            .cta h2 {
                font-size: 28px;
                margin: 0 0 7px
            }

            .cta p {
                margin: 0;
                color: #c2deda;
                font-size: 12px
            }

            .cta a {
                padding: 12px 16px;
                border-radius: 10px;
                background: #fff;
                color: #07564d;
                text-decoration: none;
                font-size: 11px;
                font-weight: 900
            }

        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: .7s
        }

            .reveal.show {
                opacity: 1;
                transform: none
            }

        @@media(max-width:900px) {
            .about {
                grid-template-columns: 1fr
            }

            .stats {
                grid-template-columns: 1fr 1fr
            }
        }

        @@media(max-width:620px) {
            .shell {
                padding: 0 16px
            }

            .hero-card {
                height: 570px
            }

            .hero-copy {
                left: 27px;
                right: 27px
            }

            .hero h1 {
                font-size: 40px
            }

            .stats {
                grid-template-columns: 1fr 1fr
            }

            .section-head, .cta {
                display: block
            }

                .section-head p {
                    margin-top: 12px
                }

            .ngo-grid, .program-grid {
                padding: 0 18px 18px
            }

            .section-head {
                padding: 24px 18px 20px
            }

            .cta a {
                display: inline-block;
                margin-top: 20px
            }
        }

        @@media(prefers-reduced-motion:reduce) {
            .reveal {
                opacity: 1;
                transform: none
            }
        }
    </style>
}
<main class="detail-page">
    <div class="shell"><nav class="crumbs"><a href="@Url.Action("Index","Home")">Home</a><span>/</span><a href="@Url.Action("Index","Causes")">Causes</a><span>/</span>@Model.CauseName</nav></div><section class="hero"><div class="shell"><div class="hero-card"><img src="@hero" alt="@Model.CauseName programme" /><div class="hero-copy"><span class="hero-tag">Active cause record</span><h1>@Model.CauseName</h1><p>@(!string.IsNullOrWhiteSpace(Model.ShortDescription)?Model.ShortDescription:Model.Description)</p><div class="stats"><div class="stat"><strong>@Model.TotalNGOsCount</strong><span>NGOs</span></div><div class="stat"><strong>@Model.TotalProgramsCount</strong><span>Programmes</span></div><div class="stat"><strong>PKR @Model.TotalFundsRaised.ToString("N0")</strong><span>Completed</span></div><div class="stat"><strong>@Model.OverallProgressPercent%</strong><span>Overall progress</span></div></div></div></div></div></section>
    <section class="content">
        <div class="shell">
            <div class="about reveal"><article class="panel"><div class="label">About this cause</div><h2>Understanding @Model.CauseName</h2><p>@(!string.IsNullOrWhiteSpace(Model.Description)?Model.Description:Model.ShortDescription)</p><div class="progress-box"><div class="track"><i style="width:@Model.OverallProgressPercent%"></i></div><div class="progress-row"><span>PKR @Model.TotalFundsRaised.ToString("N0") completed</span><span>Goal PKR @Model.TotalTargetGoal.ToString("N0")</span></div></div></article><aside class="panel"><div class="label">Cause overview</div><h2>Connected records</h2><div class="fact"><span>Associated NGOs</span><strong>@Model.TotalNGOsCount organisations</strong></div><div class="fact"><span>Programmes</span><strong>@Model.TotalProgramsCount initiatives</strong></div><div class="fact"><span>Added to GiveAID</span><strong>@Model.CreatedAt.ToString("MMMM yyyy")</strong></div></aside></div>
            <div class="section-head reveal"><div><div class="label">Organisations</div><h2>NGOs working in this area</h2></div><p>These active NGO records are connected through programmes under this cause.</p></div>@if (Model.NGOs != null && Model.NGOs.Any())
            {<div class="ngo-grid reveal">
                    @foreach (var n in Model.NGOs)
                    {
                        string initials = string.Join("", (n.NGOName ?? "NG").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x.Substring(0, 1))).ToUpperInvariant(); string copy = string.IsNullOrWhiteSpace(n.Description) ? "Organisation connected to this cause on GiveAID." : n.Description; if (copy.Length > 115) { copy = copy.Substring(0, 115) + "..."; }<a class="ngo-card" href="@Url.Action("Details","NGO",new{id=n.NGOID})">
                            <div class="ngo-top">
                                <div class="logo">
                                    @if (!string.IsNullOrWhiteSpace(n.LogoURL))
                                    {<img src="@n.LogoURL" alt="@n.NGOName logo" />}
                                    else
                                    {@initials}
                            </div><div><h3>@n.NGOName</h3><small>@n.City</small></div>
                        </div><p>@copy</p><div class="ngo-meta"><span>@n.ProgramsCount programme(s)</span><span>View profile &#8594;</span></div>
                    </a>}
        </div>}
    else
    {<div class="empty reveal">No active NGO records are connected to this cause.</div>}
            <div class="section-head reveal"><div><div class="label">Initiatives</div><h2>Programmes under @Model.CauseName</h2></div><p>Progress uses completed demonstration donation records from the database.</p></div>@if (Model.Programs != null && Model.Programs.Any())
            {<div class="program-grid reveal">
                    @foreach (var p in Model.Programs)
                    {
                        string image = string.IsNullOrWhiteSpace(p.ImageURL) ? hero : p.ImageURL; string copy = string.IsNullOrWhiteSpace(p.Description) ? "Programme details maintained by the administrator." : p.Description; if (copy.Length > 125) { copy = copy.Substring(0, 125) + "..."; }<article class="program-card"><div class="program-image"><img src="@image" alt="@p.ProgramName" /><span class="program-status">@p.Status</span></div><div class="program-body"><div class="program-ngo">@p.NGOName</div><h3>@p.ProgramName</h3><p>@copy</p><div class="track"><i style="width:@p.ProgressPercent%"></i></div><div class="progress-row"><span>PKR @p.CurrentAmount.ToString("N0")</span><span>@p.ProgressPercent% of @p.TargetAmount.ToString("N0")</span></div><div class="program-actions"><a href="@Url.Action("Create","Donation",new{programId=p.ProgramID,causeId=p.CauseID,ngoId=p.NGOID})">Contribute</a>@if (Request.IsAuthenticated || Session["UserID"] != null)
                        {
                            using (Html.BeginForm("SaveInterest", "Dashboard", FormMethod.Post))
                            {@Html.AntiForgeryToken()<input type="hidden" name="programId" value="@p.ProgramID" /><input type="hidden" name="returnUrl" value="@Request.RawUrl" /><button type="submit">Save interest</button>}
                    }</div></div></article>}
        </div>}
    else
    {<div class="empty reveal">No active or upcoming programmes are currently available.</div>}
            <div class="cta reveal"><div><h2>Explore more areas of work.</h2><p>Return to the causes directory and discover other community programmes.</p></div><a href="@Url.Action("Index","Causes")">Browse all causes</a></div>
        </div>
    </section>
</main>
@section Scripts{
    <script>(function () { var items = document.querySelectorAll('.reveal'); if ('IntersectionObserver' in window) { var o = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('show'); o.unobserve(e.target); } }); }, { threshold: .1 }); items.forEach(function (x) { o.observe(x); }); } else { items.forEach(function (x) { x.classList.add('show'); }); } })();</script>
}
