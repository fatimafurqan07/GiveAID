@{
    Layout = null;

    string c = Convert.ToString(
        ViewContext.RouteData.Values["controller"] ?? "");

    string a = Convert.ToString(
        ViewContext.RouteData.Values["action"] ?? "");

    string sessionRole = Convert.ToString(
        Session["UserRole"] ?? "");

    bool hasSignedInAccount =
        Request.IsAuthenticated || Session["UserID"] != null;

    // The authentication cookie can remain valid after the ASP.NET Session
    // expires. In that case, use the authenticated principal as the reliable
    // fallback instead of incorrectly treating an administrator as a User.
    bool isAdmin =
        hasSignedInAccount &&
        (
            sessionRole.Equals(
                "Admin",
                StringComparison.OrdinalIgnoreCase) ||
            User.IsInRole("Admin")
        );

    string userRole = isAdmin ? "Admin" : "User";

    if (hasSignedInAccount)
    {
        Session["UserRole"] = userRole;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@(ViewBag.Title??"GiveAID")</title>
    <meta name="description" content="Explore NGOs, causes and community programmes with GiveAID." />
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <style>
        :root {
            --navy: #071f2c;
            --navy2: #0d3440;
            --emerald: #087f5b;
            --green: #13a36f;
            --mint: #e8f7f0;
            --ivory: #fffaf1;
            --coral: #ef7f61;
            --gold: #f2bd5a;
            --ink: #102f35;
            --muted: #63777b;
            --line: #dbe7e4;
            --white: #fff
        }

        * {
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth
        }

        body {
            margin: 0;
            background: #fff;
            color: var(--ink);
            font-family: Segoe UI,Arial,sans-serif
        }

        .global-header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(255,255,255,.92);
            border-bottom: 1px solid rgba(10,61,64,.1);
            backdrop-filter: blur(16px)
        }

        .global-nav {
            max-width: 1240px;
            min-height: 78px;
            margin: auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 38px
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;
            text-decoration: none;
            color: var(--navy);
            font-size: 23px;
            font-weight: 900;
            letter-spacing: -.03em
        }

        .logo-mark {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            background: linear-gradient(145deg,var(--emerald),#10a36e);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 12px;
            box-shadow: 0 9px 22px rgba(8,127,91,.22)
        }

        .logo span {
            color: var(--emerald)
        }

        .nav-toggle {
            display: none;
            margin-left: auto;
            border: 0;
            background: var(--mint);
            border-radius: 10px;
            padding: 10px
        }

            .nav-toggle i {
                display: block;
                width: 20px;
                height: 2px;
                background: var(--navy);
                margin: 4px
            }

        .nav-area {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex: 1
        }

        .main-links, .account-links {
            display: flex;
            align-items: center;
            gap: 5px
        }

            .main-links a, .account-links a {
                font-size: 13px;
                font-weight: 700;
                color: #405d62;
                text-decoration: none;
                padding: 10px 12px;
                border-radius: 9px;
                transition: .2s
            }

                .main-links a:hover, .main-links a.active {
                    background: var(--mint);
                    color: var(--emerald)
                }

            .account-links .dashboard {
                background: var(--navy);
                color: #fff;
                padding: 11px 16px
            }

            .account-links .signup {
                background: var(--coral);
                color: #fff;
                padding: 11px 16px
            }

            .account-links .outline {
                border: 1px solid var(--line)
            }

        .flash {
            max-width: 1180px;
            margin: 12px auto 0;
            padding: 12px 15px;
            border-radius: 9px;
            font-size: 13px
        }

        .flash-ok {
            background: #e8f8ef;
            color: #126440
        }

        .flash-no {
            background: #fff0ed;
            color: #a2372d
        }

        .site-body {
            min-height: 65vh
        }

        .global-footer {
            background: var(--navy);
            color: #d4e4e5;
            margin-top: 0
        }

        .footer-grid {
            max-width: 1200px;
            margin: auto;
            padding: 64px 24px 42px;
            display: grid;
            grid-template-columns: 1.7fr 1fr 1fr 1fr;
            gap: 44px
        }

        .footer-logo {
            font-size: 24px;
            font-weight: 900;
            color: #fff
        }

            .footer-logo span {
                color: #43d19a
            }

        .footer-copy {
            color: #9cb8bc;
            font-size: 13px;
            line-height: 1.75;
            max-width: 410px;
            margin-top: 15px
        }

        .footer-heading {
            color: #fff;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .11em;
            font-weight: 800;
            margin-bottom: 16px
        }

        .footer-links a {
            display: block;
            color: #afc6c9;
            text-decoration: none;
            font-size: 13px;
            margin: 10px 0
        }

            .footer-links a:hover {
                color: #fff
            }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,.1);
            max-width: 1200px;
            margin: auto;
            padding: 20px 24px;
            color: #809fa4;
            font-size: 12px;
            display: flex;
            justify-content: space-between
        }

        @@media(max-width:900px) {
            .global-nav {
                flex-wrap: wrap;
                padding-top: 13px;
                padding-bottom: 13px
            }

            .nav-toggle {
                display: block
            }

            .nav-area {
                display: none;
                width: 100%;
                align-items: stretch
            }

                .nav-area.open {
                    display: flex;
                    flex-direction: column
                }

            .main-links, .account-links {
                flex-direction: column;
                align-items: stretch
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr
            }

            .footer-bottom {
                display: block
            }
        }

        @@media(max-width:550px) {
            .footer-grid {
                grid-template-columns: 1fr
            }
        }
    </style>
    @RenderSection("Styles", false)
</head>
<body>
    <header class="global-header">
        <nav class="global-nav">
            <a class="logo" href="@Url.Action("Index", "Home")">
                <b class="logo-mark">GA</b>Give<span>AID</span>
            </a>

            <button class="nav-toggle" id="navToggle" aria-label="Menu">
                <i></i><i></i><i></i>
            </button>

            <div class="nav-area" id="navArea">
                <div class="main-links">
                    <a class="@(c == "Home" && a == "Index" ? "active" : "")"
                       href="@Url.Action("Index", "Home")">Home</a>

                    <a class="@(c == "Home" && a == "About" ? "active" : "")"
                       href="@Url.Action("About", "Home")">About</a>

                    <a class="@(c == "NGO" ? "active" : "")"
                       href="@Url.Action("Index", "NGO")">NGOs</a>

                    <a class="@(c == "Causes" ? "active" : "")"
                       href="@Url.Action("Index", "Causes")">Causes</a>

                    <a class="@(c == "Home" && a == "Partners" ? "active" : "")"
                       href="@Url.Action("Partners", "Home")">Partners</a>

                    <a class="@(c == "Home" && a == "Contact" ? "active" : "")"
                       href="@Url.Action("Contact", "Home")">Contact</a>
                </div>

                <div class="account-links">
                    @if (Request.IsAuthenticated || Session["UserID"] != null)
                    {
                        if (userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="dashboard"
                               href="@Url.Action("Admin", "Dashboard")">
                                Admin Panel
                            </a>
                        }
                        else
                        {
                            <a class="dashboard"
                               href="@Url.Action("UserDashboard", "Dashboard")">
                                My Account
                            </a>
                        }

                        <a class="outline"
                           href="@Url.Action("Logout", "Account")">
                            Sign out
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")">
                            Sign in
                        </a>

                        <a class="signup"
                           href="@Url.Action("Register", "Account")">
                            Join GiveAID
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flash flash-ok">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flash flash-no">
            @TempData["ErrorMessage"]
        </div>
    }

    <main class="site-body">
        @RenderBody()
    </main>

    <footer class="global-footer">
        <div class="footer-grid">
            <div>
                <div class="footer-logo">Give<span>AID</span></div>
                <p class="footer-copy">
                    A modern academic platform connecting registered users with
                    associated NGOs, social causes and community programmes.
                </p>
            </div>

            <div>
                <div class="footer-heading">Discover</div>
                <div class="footer-links">
                    <a href="@Url.Action("Index", "NGO")">NGO directory</a>
                    <a href="@Url.Action("Index", "Causes")">Active causes</a>
                    <a href="@Url.Action("Partners", "Home")">Partners</a>
                </div>
            </div>

            <div>
                <div class="footer-heading">Platform</div>
                <div class="footer-links">
                    <a href="@Url.Action("About", "Home")">About GiveAID</a>
                    <a href="@Url.Action("Contact", "Home")">Contact</a>
                    <a href="@Url.Action("Register", "Account")">Create account</a>
                </div>
            </div>

            <div>
                <div class="footer-heading">Access</div>
                <div class="footer-links">
                    @if (Request.IsAuthenticated || Session["UserID"] != null)
                    {
                        if (userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="@Url.Action("Admin", "Dashboard")">
                                Admin Panel
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("UserDashboard", "Dashboard")">
                                My Account
                            </a>
                        }

                        <a href="@Url.Action("Logout", "Account")">
                            Sign out
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")">
                            Sign in
                        </a>

                        <a href="@Url.Action("Register", "Account")">
                            Create account
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year GiveAID</span>
            <span>Semester project &middot; ASP.NET MVC &middot; SQL Server</span>
        </div>
    </footer>

    <script>
        document.getElementById('navToggle').onclick = function () {
            document.getElementById('navArea').classList.toggle('open');
        };
    </script>

    @RenderSection("Scripts", false)
</body>
</html>
