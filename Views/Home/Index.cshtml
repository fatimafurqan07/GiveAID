@{
    ViewBag.Title = "GiveAID - Transparent NGO & Charity Giving in Pakistan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- =========================================================
     HERO SECTION
     ========================================================= -->
<section class="hero-section">
    <div class="hero-container">
        <div class="hero-content">
            <div class="hero-pill">
                <span class="pulse-dot"></span>
                <span>Pakistan's 1st Transparent Giving Platform</span>
            </div>

            <h1 class="hero-title">
                Give with <span class="highlight-text">Trust</span>. Transform <span class="highlight-text-accent">Pakistan</span>.
            </h1>

            <p class="hero-subtitle">
                Connecting Pakistan's next generation of changemakers with 100% verified NGOs, emergency relief funds, and grassroots education projects. Track every single Rupee in real-time.
            </p>

            <div class="hero-cta-group">
                <a href="@Url.Action("Index", "Causes")" class="btn-primary-hero">
                    <span>Explore Causes</span>
                    <span class="btn-arrow">→</span>
                </a>
                <a href="@Url.Action("Index", "NGO")" class="btn-secondary-hero">
                    <span>Discover NGOs</span>
                </a>
                @if (Session["UserID"] != null || Request.IsAuthenticated)
                {
                    <a href="@Url.Action("Index", "Dashboard")" class="btn-secondary-hero" style="background: rgba(255,255,255,0.15); color: #fff;">
                        <span>Dashboard</span>
                    </a>
                }
            </div>

            <div class="hero-trust-badges">
                <div class="trust-badge-item">
                    <span class="badge-icon">🛡️</span>
                    <span>SECP Verified NGOs</span>
                </div>
                <div class="trust-badge-item">
                    <span class="badge-icon">⚡</span>
                    <span>Raast / JazzCash / SadaPay Ready</span>
                </div>
                <div class="trust-badge-item">
                    <span class="badge-icon">📊</span>
                    <span>100% Open Financials</span>
                </div>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-card-stack">
                <div class="hero-main-card">
                    <div class="card-hero-header">
                        <span class="category-tag tag-emergency">🚨 Urgent Relief</span>
                        <span class="location-badge">📍 Sindh & Balochistan</span>
                    </div>
                    <div class="card-hero-body">
                        <h3>Flood Reconstruction & Clean Water Hubs</h3>
                        <p>Providing solar RO water plants and weather-resilient brick shelters for 2,400+ displaced families.</p>
                        
                        <div class="cause-progress-wrap">
                            <div class="cause-progress-bar">
                                <div class="cause-progress-fill" style="width: 76%;"></div>
                            </div>
                            <div class="cause-progress-labels">
                                <span class="raised-text">Raised: <strong>PKR 3,800,000</strong></span>
                                <span class="target-text">Goal: PKR 5,000,000 (76%)</span>
                            </div>
                        </div>

                        <div class="card-hero-footer">
                            <div class="donors-avatar-group">
                                <span class="avatar-circle">👩🏽</span>
                                <span class="avatar-circle">👨🏻</span>
                                <span class="avatar-circle">🧕🏼</span>
                                <span class="avatar-count">+412 Donors</span>
                            </div>
                            <a href="#causes" class="quick-support-link">Support Cause →</a>
                        </div>
                    </div>
                </div>

                <!-- Floating Micro Badges -->
                <div class="floating-stat-card float-stat-left">
                    <div class="float-icon">💚</div>
                    <div>
                        <div class="float-val">PKR 180M+</div>
                        <div class="float-desc">Delivered to Ground</div>
                    </div>
                </div>

                <div class="floating-stat-card float-stat-right">
                    <div class="float-icon">✓</div>
                    <div>
                        <div class="float-val">150+ NGOs</div>
                        <div class="float-desc">Strictly Audited</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- =========================================================
     PLATFORM IMPACT / STATISTICS SECTION
     ========================================================= -->
<section class="impact-stats-section">
    <div class="section-container">
        <div class="section-header-center">
            <span class="section-badge">Real-Time Metrics</span>
            <h2 class="section-title">Measurable Impact Across Pakistan</h2>
            <p class="section-subtitle">Every donation through GiveAID is tracked on-chain and in our transparent portal. Here is what we have achieved together.</p>
        </div>

        <div class="impact-grid">
            <div class="impact-card">
                <div class="impact-icon-wrapper icon-accent-green">
                    <span>🏢</span>
                </div>
                <div class="impact-number" data-target="150">150+</div>
                <div class="impact-title">Verified Partner NGOs</div>
                <div class="impact-sub">Thoroughly vetted for SECP compliance, financial audits, and zero tax avoidance.</div>
            </div>

            <div class="impact-card">
                <div class="impact-icon-wrapper icon-accent-blue">
                    <span>🎯</span>
                </div>
                <div class="impact-number" data-target="1200">1,200+</div>
                <div class="impact-title">Completed Projects</div>
                <div class="impact-sub">Covering emergency disaster relief, girl child schooling, orphan care, and healthcare.</div>
            </div>

            <div class="impact-card">
                <div class="impact-icon-wrapper icon-accent-gold">
                    <span>👥</span>
                </div>
                <div class="impact-number" data-target="450000">450,000+</div>
                <div class="impact-title">Lives Positively Touched</div>
                <div class="impact-sub">Families fed, students educated, patients treated, and rural homes electrified.</div>
            </div>

            <div class="impact-card">
                <div class="impact-icon-wrapper icon-accent-emerald">
                    <span>💸</span>
                </div>
                <div class="impact-number">PKR 180M+</div>
                <div class="impact-title">Charity Distributed</div>
                <div class="impact-sub">Zero hidden deductions. 100% of donor funding routed directly to verified programs.</div>
            </div>
        </div>
    </div>
</section>


<!-- =========================================================
     FEATURED CAUSES SECTION
     ========================================================= -->
<section class="featured-causes-section" id="causes">
    <div class="section-container">
        <div class="causes-header-row">
            <div>
                <span class="section-badge">Active Campaigns</span>
                <h2 class="section-title">Urgent Causes Needing Your Support</h2>
                <p class="section-subtitle">Support vetted humanitarian initiatives across Karachi, Lahore, Quetta, Peshawar, and rural Pakistan.</p>
            </div>
            <div class="causes-filter-pills">
                <button class="filter-pill active" onclick="filterCauses('all', this)">All Causes</button>
                <button class="filter-pill" onclick="filterCauses('education', this)">Education</button>
                <button class="filter-pill" onclick="filterCauses('relief', this)">Emergency Relief</button>
                <button class="filter-pill" onclick="filterCauses('health', this)">Healthcare</button>
                <button class="filter-pill" onclick="filterCauses('water', this)">Clean Water</button>
            </div>
        </div>

        <div class="causes-grid">
            <!-- Cause 1 -->
            <div class="cause-card" data-category="relief">
                <div class="cause-card-banner banner-relief">
                    <span class="cause-tag">Emergency Relief</span>
                    <span class="cause-org">Sindh Relief Coalition</span>
                </div>
                <div class="cause-card-content">
                    <div class="cause-location">📍 Dadu & Sukkur, Sindh</div>
                    <h3 class="cause-name">Flood Rehabilitation & Brick Shelter Homes</h3>
                    <p class="cause-desc">Constructing durable, climate-resilient brick rooms for 180 farmer families displaced by devastating flash floods.</p>
                    
                    <div class="cause-financials">
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill" style="width: 72%;"></div>
                        </div>
                        <div class="funding-meta">
                            <span class="amount-raised">PKR 3,600,000</span>
                            <span class="amount-target">Goal: PKR 5,000,000</span>
                        </div>
                        <div class="funding-footer-meta">
                            <span class="funded-pct">72% Funded</span>
                            <span class="donors-meta">👥 390 Donors</span>
                        </div>
                    </div>

                    <div class="cause-actions">
                        <button type="button" class="btn-donate-card" onclick="openDonationModal('Flood Rehabilitation & Brick Shelter Homes', 'PKR 5,000,000', 'Sindh Relief Coalition')">
                            Donate Now
                        </button>
                        <a href="@Url.Action("Contact", "Home")" class="btn-info-card" title="Contact NGO / Inquire">💬 Inquire</a>
                    </div>
                </div>
            </div>

            <!-- Cause 2 -->
            <div class="cause-card" data-category="health">
                <div class="cause-card-banner banner-health">
                    <span class="cause-tag">Healthcare</span>
                    <span class="cause-org">Edhi Emergency Network</span>
                </div>
                <div class="cause-card-content">
                    <div class="cause-location">📍 Nationwide Highway Ambulances</div>
                    <h3 class="cause-name">Emergency Ambulance & ICU Life-Support Fleet</h3>
                    <p class="cause-desc">Equipping 25 national highway ambulances with oxygen concentrators, automated defibrillators, and trauma response kits.</p>
                    
                    <div class="cause-financials">
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill" style="width: 85%;"></div>
                        </div>
                        <div class="funding-meta">
                            <span class="amount-raised">PKR 8,500,000</span>
                            <span class="amount-target">Goal: PKR 10,000,000</span>
                        </div>
                        <div class="funding-footer-meta">
                            <span class="funded-pct">85% Funded</span>
                            <span class="donors-meta">👥 1,120 Donors</span>
                        </div>
                    </div>

                    <div class="cause-actions">
                        <button type="button" class="btn-donate-card" onclick="openDonationModal('Emergency Ambulance & ICU Life-Support Fleet', 'PKR 10,000,000', 'Edhi Emergency Network')">
                            Donate Now
                        </button>
                        <a href="@Url.Action("Contact", "Home")" class="btn-info-card" title="Contact NGO / Inquire">💬 Inquire</a>
                    </div>
                </div>
            </div>

            <!-- Cause 3 -->
            <div class="cause-card" data-category="education">
                <div class="cause-card-banner banner-tech">
                    <span class="cause-tag">Youth & IT</span>
                    <span class="cause-org">Saylani Welfare Tech</span>
                </div>
                <div class="cause-card-content">
                    <div class="cause-location">📍 Karachi, Lahore & Faisalabad</div>
                    <h3 class="cause-name">Mass IT Training & AI Scholarships for Youth</h3>
                    <p class="cause-desc">Sponsoring 500 underprivileged Gen Z students through comprehensive software engineering, cloud computing, and AI bootcamps.</p>
                    
                    <div class="cause-financials">
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill" style="width: 80%;"></div>
                        </div>
                        <div class="funding-meta">
                            <span class="amount-raised">PKR 4,800,000</span>
                            <span class="amount-target">Goal: PKR 6,000,000</span>
                        </div>
                        <div class="funding-footer-meta">
                            <span class="funded-pct">80% Funded</span>
                            <span class="donors-meta">👥 680 Donors</span>
                        </div>
                    </div>

                    <div class="cause-actions">
                        <button type="button" class="btn-donate-card" onclick="openDonationModal('Mass IT Training & AI Scholarships for Youth', 'PKR 6,000,000', 'Saylani Welfare Tech')">
                            Donate Now
                        </button>
                        <a href="@Url.Action("Contact", "Home")" class="btn-info-card" title="Contact NGO / Inquire">💬 Inquire</a>
                    </div>
                </div>
            </div>

            <!-- Cause 4 -->
            <div class="cause-card" data-category="education">
                <div class="cause-card-banner banner-education">
                    <span class="cause-tag">Education</span>
                    <span class="cause-org">The Citizens Foundation</span>
                </div>
                <div class="cause-card-content">
                    <div class="cause-location">📍 Rural Punjab & KPK</div>
                    <h3 class="cause-name">Girls' Primary & Secondary Schooling Kits</h3>
                    <p class="cause-desc">Providing full-year uniforms, textbooks, solar classroom power, and nutritious daily lunches for 350 rural female scholars.</p>
                    
                    <div class="cause-financials">
                        <div class="progress-bar-container">
                            <div class="progress-bar-fill" style="width: 90%;"></div>
                        </div>
                        <div class="funding-meta">
                            <span class="amount-raised">PKR 3,150,000</span>
                            <span class="amount-target">Goal: PKR 3,500,000</span>
                        </div>
                        <div class="funding-footer-meta">
                            <span class="funded-pct">90% Funded</span>
                            <span class="donors-meta">👥 520 Donors</span>
                        </div>
                    </div>

                    <div class="cause-actions">
                        <button type="button" class="btn-donate-card" onclick="openDonationModal('Girls Primary & Secondary Schooling Kits', 'PKR 3,500,000', 'The Citizens Foundation')">
                            Donate Now
                        </button>
                        <a href="@Url.Action("Contact", "Home")" class="btn-info-card" title="Contact NGO / Inquire">💬 Inquire</a>
                    </div>
                </div>
            </div>

            <!-- Cause 5 -->
            <div class="cause-card" data-category="water">
                <div class="cause-card-banner banner-water">
                    <span class="cause-tag">Clean Water</span>
                    <span class="cause-org">Thar Water Initiative</span>
                </div>
                <div class="cause-card-content">
                    <div class="cause-location">📍 Tharparkar & Umerkot</div>
                    <h3 class="cause-name">Solar-Powered Reverse Osmosis Water Plants</h3>
                    <p class="cause-desc">Installing 4 high-capacity deep-well solar RO filtration plants to supply fluoride-free drinking water to 6 remote desert villages.</p>
                    
                    <div class="cause-financials">
                        <div class="progress-bar-container">
