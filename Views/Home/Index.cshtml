<!-- =========================================================
     HOW GIVEAID WORKS (4-STEP STREAMLINED MODEL)
     ========================================================= -->
<section class="how-it-works-section">
    <div class="section-container">
        <div class="section-header-center">
            <span class="section-badge">Transparent Workflow</span>
            <h2 class="section-title">How GiveAID Works</h2>
            <p class="section-subtitle">We stripped away the red tape and opaque charity practices to build a frictionless giving experience.</p>
        </div>

        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number-badge">01</div>
                <div class="step-icon-wrap">🔍</div>
                <h3>1. Discover a Verified Cause</h3>
                <p>Browse rigorously vetted non-profit campaigns across Pakistan with transparent goal breakdowns and field reports.</p>
            </div>

            <div class="step-card">
                <div class="step-number-badge">02</div>
                <div class="step-icon-wrap">💳</div>
                <h3>2. Choose How to Give</h3>
                <p>Donate in PKR using your favorite everyday payment channels: Raast, JazzCash, SadaPay, NayaPay, or direct Bank Transfer.</p>
            </div>

            <div class="step-card">
                <div class="step-number-badge">03</div>
                <div class="step-icon-wrap">🛡️</div>
                <h3>3. 100% Financial Tracking</h3>
                <p>Every single Rupee is accounted for. Check itemized expenditure bills, contractor receipts, and NGO disbursements.</p>
            </div>

            <div class="step-card">
                <div class="step-number-badge">04</div>
                <div class="step-icon-wrap">🌟</div>
                <h3>4. Witness Tangible Impact</h3>
                <p>Receive verifiable photo receipts, beneficiary progress updates, and tax certificates directly inside your personal donor portal.</p>
            </div>
        </div>
    </div>
</section>


<!-- =========================================================
     WHY GIVEAID (TRUST & VALUE PILLARS)
     ========================================================= -->
<section class="why-giveaid-section">
    <div class="section-container">
        <div class="why-grid">
            <div class="why-intro-col">
                <span class="section-badge">Trust by Design</span>
                <h2 class="section-title">Why Changemakers Choose GiveAID</h2>
                <p class="section-subtitle">
                    For decades, charitable giving in Pakistan has been hindered by a lack of audit transparency and digital friction. GiveAID solves this with verifiable, youth-led accountability.
                </p>
                <div class="why-cta-box">
                    <p>Have questions about our NGO verification and safety standards?</p>
                    <a href="@Url.Action("About", "Home")" class="btn-outline-green">Learn About Our Mission →</a>
                </div>
            </div>

            <div class="why-features-col">
                <div class="why-feature-card">
                    <div class="feature-icon">🛡️</div>
                    <div class="feature-text">
                        <h4>100% SECP & Tax Verified NGOs</h4>
                        <p>We do not onboard anonymous charities. Every organization submits legal registration, annual audit filings, and field verification.</p>
                    </div>
                </div>

                <div class="why-feature-card">
                    <div class="feature-icon">💎</div>
                    <div class="feature-text">
                        <h4>Zero Hidden Deductions</h4>
                        <p>Unlike legacy charity portals that charge 10–15% management cuts, GiveAID passes 100% of your allocated funds directly to the field.</p>
                    </div>
                </div>

                <div class="why-feature-card">
                    <div class="feature-icon">📱</div>
                    <div class="feature-text">
                        <h4>Built for Gen Z & Digital Pakistan</h4>
                        <p>A lightning-fast, mobile-first interface designed for effortless giving on mobile phones without cumbersome manual paperwork.</p>
                    </div>
                </div>

                <div class="why-feature-card">
                    <div class="feature-icon">📊</div>
                    <div class="feature-text">
                        <h4>Real-Time Donor Dashboard</h4>
                        <p>Log in anytime to see your lifetime impact metrics, downloadable PDF receipts, and project milestone updates.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


