                        <a href="@Url.Action("Contact", "Home")" class="btn-info-card" title="Contact NGO / Inquire">💬 Inquire</a>
                    </div>
                </div>
            </div>

            <!-- Cause 6 -->
            <div class="cause-card" data-category="relief">
                <div class="cause-card-banner banner-microfinance">
