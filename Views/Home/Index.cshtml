                <span>🎯 Browse All Causes & Sectors</span>
                <span class="btn-arrow">→</span>
            </a>
            <a href="@Url.Action("Index", "NGO")" class="btn-secondary-hero" style="background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; display: inline-flex; align-items: center; gap: 8px;">
