<!-- =========================================================
     PARTNER VERIFICATION CRITERIA & ONBOARDING CALLOUT
     ========================================================= -->
<section class="partner-onboarding-section">
    <div class="section-container">
        <div class="onboarding-banner-box">
            <div class="onboarding-text-wrap">
                <span class="section-badge">Join Our Coalition</span>
                <h2>Become a GiveAID Partner Organization</h2>
                <p>
                    Are you a registered charitable trust, non-profit society, or section 42 company in Pakistan? Partner with GiveAID to gain access to transparent fundraising tools, Gen Z donors, and corporate CSR allocations.
                </p>
                <div class="criteria-checklist">
                    <div class="criterion-item">
                        <span class="check-icon">✓</span>
                        <span>SECP Section 42 / Societies Registration Act 1860 documentation</span>
                    </div>
                    <div class="criterion-item">
                        <span class="check-icon">✓</span>
                        <span>FBR Tax Exemption / NPO certification (Rule 212 / Section 2(36))</span>
                    </div>
                    <div class="criterion-item">
                        <span class="check-icon">✓</span>
                        <span>Minimum 2 years of audited financial statements by a certified CA</span>
                    </div>
                    <div class="criterion-item">
                        <span class="check-icon">✓</span>
                        <span>Active, verifiable field operations with photographic milestone reporting</span>
                    </div>
                </div>
                <div class="onboarding-actions">
                    <a href="@Url.Action("Register", "Account")" class="btn-primary-hero">
                        Apply for NGO Verification →
                    </a>
                    <a href="@Url.Action("Contact", "Home")" class="btn-secondary-hero">
                        Contact Partnerships Team
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
        function filterPartners(sector, btn) {
            $('.partner-category-filters .filter-pill').removeClass('active');
            $(btn).addClass('active');

            if (sector === 'all') {
                $('.partner-card').fadeIn(200);
            } else {
                $('.partner-card').hide();
                $('.partner-card').each(function () {
                    var dataSector = $(this).attr('data-sector') || '';
                    if (dataSector.indexOf(sector) !== -1) {
                        $(this).fadeIn(200);
                    }
                });
            }
        }
    </script>
}
