@model GiveAID_Project.Models.DonationDetailViewModel
@using System

@{
    ViewBag.Title = "Contribution Submitted | GiveAID";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var programmeName = string.IsNullOrWhiteSpace(Model.ProgramName) ||
                        Model.ProgramName.Equals(
                            "General Cause Fund",
                            StringComparison.OrdinalIgnoreCase)
        ? "General cause fund"
        : Model.ProgramName;

    var paymentMethod = string.IsNullOrWhiteSpace(Model.PaymentMethod)
        ? "Demonstration payment"
        : Model.PaymentMethod;
}

@section Styles {
    <link href="@Url.Content("~/Content/UserDashboard.css")"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/DonationFlow.css?v=20260825")"
          rel="stylesheet" />

    <style>
        .receipt-user-main {
            padding: 34px 30px 75px;
            background: radial-gradient( circle at 4% 5%, rgba(17, 170, 125, 0.12), transparent 28% ), radial-gradient( circle at 96% 9%, rgba(244, 127, 97, 0.11), transparent 27% ), linear-gradient( 135deg, #eef8f4, #fff9f1 52%, #f2f8f6 );
        }

        .dashboard-receipt-page {
            min-height: 0;
            padding: 0;
            background: transparent;
        }

        .receipt-reference-chip {
            position: relative;
            z-index: 2;
            display: inline-flex;
            margin-top: 17px;
            padding: 8px 13px;
            border: 1px solid rgba(255, 255, 255, 0.20);
            border-radius: 999px;
            color: #d6eee9;
            background: rgba(255, 255, 255, 0.09);
            font-family: Consolas, monospace;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.04em;
        }

        .receipt-note {
            margin-top: 15px;
            padding: 14px;
            border: 1px solid #d6e5e0;
            border-radius: 13px;
            color: #536e73;
            background: #ffffff;
            font-size: 9px;
            line-height: 1.65;
        }

            .receipt-note strong {
                display: block;
                margin-bottom: 5px;
                color: #173e45;
                font-style: normal;
            }

        @@media (max-width: 720px) {
            .receipt-user-main {
                padding: 25px 15px 55px;
            }
        }
    </style>
}

<main class="user-workspace">
    <div class="user-shell">

        @Html.Partial("_UserDashboardSidebar")

        <section class="user-main receipt-user-main">
            <div class="receipt-page dashboard-receipt-page">
                <section class="receipt-shell">

                    <header class="receipt-hero">
                        <div class="receipt-mark">OK</div>

                        <h1>
                            Your contribution is now recorded.
                        </h1>

                        <p>
                            Thank you, @Model.DonorName. Your contribution
                            has entered GiveAID's transparent administrator
                            review workflow.
                        </p>

                        <span class="receipt-reference-chip">
                            Reference: @Model.PaymentReference
                        </span>
                    </header>

                    <div class="receipt-content">

                        <section class="receipt-status">
                            <div class="receipt-status-code">PN</div>

                            <div>
                                <strong>
                                    Pending administrator review
                                </strong>

                                <p>
                                    Your record has been saved in the
                                    GiveAID database and linked to your
                                    account. An administrator will review
                                    and update its final status.
                                </p>
                            </div>
                        </section>

                        <div class="receipt-grid">
                            <section class="receipt-details">
                                <h2>Contribution receipt</h2>

                                <div class="receipt-row">
                                    <span>Reference number</span>
                                    <strong>
                                        @Model.PaymentReference
                                    </strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Supporter</span>
                                    <strong>@Model.DonorName</strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Receipt email</span>
                                    <strong>@Model.DonorEmail</strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Partner organisation</span>
                                    <strong>@Model.NGOName</strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Cause</span>
                                    <strong>@Model.CauseName</strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Programme</span>
                                    <strong>@programmeName</strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Demonstration method</span>
                                    <strong>@paymentMethod</strong>
                                </div>

                                <div class="receipt-row">
                                    <span>Submitted</span>
                                    <strong>
                                        @Model.DonationDate.ToString(
                                                 "dd MMM yyyy, hh:mm tt")
                                    </strong>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Message))
                                {
                                    <div class="receipt-note">
                                        <strong>Your message</strong>
                                        <span>@Model.Message</span>
                                    </div>
                                }

                                <div class="receipt-row total">
                                    <span>Total contribution</span>
                                    <strong>
                                        PKR @Model.Amount.ToString("N0")
                                    </strong>
                                </div>
                            </section>

                            <aside class="receipt-next">
                                <h2>What happens next?</h2>

                                <p>
                                    You do not need to submit this record
                                    again. Its status will update after
                                    administrator review.
                                </p>

                                <div class="next-step">
                                    <b>01</b>
                                    <div>
                                        <strong>Record created</strong>
                                        <span>
                                            Your contribution is linked
                                            to your signed-in account.
                                        </span>
                                    </div>
                                </div>

                                <div class="next-step">
                                    <b>02</b>
                                    <div>
                                        <strong>Review pending</strong>
                                        <span>
                                            An administrator checks the
                                            submitted contribution details.
                                        </span>
                                    </div>
                                </div>

                                <div class="next-step">
                                    <b>03</b>
                                    <div>
                                        <strong>Status updated</strong>
                                        <span>
                                            Follow the final result from
                                            your My Donations page.
                                        </span>
                                    </div>
                                </div>
                            </aside>
                        </div>

                        <div class="receipt-actions">
                            <a class="receipt-button"
                               href="@Url.Action(
                                   "UserDashboard",
                                   "Dashboard")">
                                Back to dashboard
                            </a>

                            <a class="receipt-button"
                               href="@Url.Action(
                                   "Create",
                                   "Donation")">
                                Make another donation
                            </a>

                            @if (Session["UserID"] != null ||
                                 Request.IsAuthenticated)
                            {
                                <a class="receipt-button primary"
                                   href="@Url.Action(
                                       "Donations",
                                       "Dashboard")">
                                    Track in My Donations
                                </a>
                            }
                            else
                            {
                                <a class="receipt-button primary"
                                   href="@Url.Action(
                                       "Register",
                                       "Account")">
                                    Create an account
                                </a>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </section>
    </div>
</main>
