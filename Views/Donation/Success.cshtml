@model GiveAID_Project.Models.DonationDetailViewModel

@{
    ViewBag.Title = "Donation Submitted - GiveAID";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page-container" style="max-width: 720px; margin: 40px auto; padding: 0 20px;">
    <div class="auth-card" style="background: #ffffff; border-radius: 20px; padding: 36px; border: 1px solid #e2e8f0; box-shadow: 0 12px 30px -5px rgba(0,0,0,0.06); text-align: center;">
        
        <div style="width: 64px; height: 64px; background: #dcfce7; color: #166534; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 16px auto;">
            ✓
        </div>

        <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin-bottom: 6px;">
            Thank You for Your Generosity!
        </h1>
        <p style="color: #64748b; font-size: 15px; margin-bottom: 24px;">
            Your donation has been created and logged in the GiveAID verification pipeline.
        </p>

        <!-- Status Card -->
        <div style="background: #fffbeb; border: 1px solid #fef3c7; border-radius: 12px; padding: 16px; margin-bottom: 24px; text-align: left; display: flex; align-items: center; gap: 14px;">
            <div style="font-size: 24px;">⏳</div>
            <div>
                <div style="font-weight: 700; color: #92400e; font-size: 14px;">
                    Current Status: <span class="status-pill status-pending" style="font-size: 13px; padding: 2px 10px;">Pending Admin Approval</span>
                </div>
                <div style="font-size: 13px; color: #b45309; margin-top: 2px;">
                    This donation is visible to <strong>@Model.NGOName</strong> and is awaiting final sign-off by the Platform Administrator.
                </div>
            </div>
        </div>

        <!-- Receipt Details Table -->
        <div style="background: #f8fafc; border-radius: 14px; border: 1px solid #e2e8f0; padding: 20px; margin-bottom: 24px; text-align: left;">
            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Donation Reference:</span>
                <strong style="color: #0f172a; font-family: monospace; font-size: 15px;">@Model.PaymentReference</strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Donor Name:</span>
                <strong style="color: #0f172a;">@Model.DonorName</strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Donor Email:</span>
                <strong style="color: #0f172a;">@Model.DonorEmail</strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Partner NGO:</span>
                <strong style="color: #0f172a;">@Model.NGOName</strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Cause / Program:</span>
                <strong style="color: #0f172a;">@Model.CauseName @(string.IsNullOrEmpty(Model.ProgramName) || Model.ProgramName == "General Cause Fund" ? "" : $"({Model.ProgramName})")</strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Payment Method:</span>
                <strong style="color: #0f172a;">@Model.PaymentMethod</strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                <span style="color: #64748b;">Date & Time:</span>
                <strong style="color: #0f172a;">@Model.DonationDate.ToString("MMM dd, yyyy HH:mm")</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Message))
            {
                <div style="padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px;">
                    <span style="color: #64748b; display: block; margin-bottom: 4px;">Donor Note / Message:</span>
                    <em style="color: #334155; display: block; background: #ffffff; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2e8f0;">"@Model.Message"</em>
                </div>
            }

            <div style="display: flex; justify-content: space-between; padding: 12px 0 4px 0; font-size: 16px;">
                <span style="font-weight: 700; color: #0f172a;">Total Amount:</span>
                <strong style="color: #166534; font-size: 22px;">PKR @Model.Amount.ToString("N0")</strong>
            </div>
        </div>

        <!-- Next Steps Box -->
        <div style="background: #f0fdf4; border-radius: 12px; border: 1px solid #bbf7d0; padding: 18px; margin-bottom: 28px; text-align: left;">
            <h4 style="font-size: 14px; font-weight: 700; color: #166534; margin-bottom: 8px;">
                🔍 2-Way Visibility & Final Settlement
            </h4>
            <p style="font-size: 13px; color: #15803d; line-height: 1.5; margin: 0;">
                Your donation is now visible to <strong>@Model.NGOName</strong> so their team can prepare field allocation. The GiveAID <strong>Platform Administrator</strong> reviews every incoming donation before marking it <em>Approved</em> to maintain 100% SECP regulatory compliance.
            </p>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="@Url.Action("Index", "Home")" class="btn-secondary-hero" style="text-decoration: none; padding: 12px 24px;">
                ← Return to Homepage
            </a>

            @if (Session["UserID"] != null || Request.IsAuthenticated)
            {
                <a href="@Url.Action("Index", "Dashboard")" class="auth-btn" style="text-decoration: none; padding: 12px 24px;">
                    Go to My Dashboard →
                </a>
            }
            else
            {
                <a href="@Url.Action("Register", "Account")" class="auth-btn" style="text-decoration: none; padding: 12px 24px;">
                    Create Account to Track Giving →
                </a>
            }
        </div>

    </div>
</div>
