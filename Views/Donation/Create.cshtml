@model GiveAID_Project.Models.DonationFormDataViewModel
@using System
@using System.Linq

@{
    ViewBag.Title = "Make a Donation | GiveAID";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var selectedNgo = Model.NGOs.FirstOrDefault(n => n.ID == Model.FormModel.NGOID);
    var selectedCause = Model.Causes.FirstOrDefault(c => c.ID == Model.FormModel.CauseID);

    var selectedNgoName = selectedNgo == null
        ? "Not selected"
        : selectedNgo.Name;

    var selectedCauseName = selectedCause == null
        ? "Not selected"
        : selectedCause.Name;

    var initialAmount = Model.FormModel.Amount > 0
        ? Model.FormModel.Amount
        : 2500;

    var initialPaymentRail = string.IsNullOrWhiteSpace(Model.FormModel.PaymentRail)
        ? "Raast / 1Link"
        : Model.FormModel.PaymentRail;
}

@section Styles {
    <link href="@Url.Content("~/Content/UserDashboard.css")"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/DonationFlow.css?v=20260825")"
          rel="stylesheet" />
}

<main class="user-workspace">
    <div class="user-shell">

        @Html.Partial("_UserDashboardSidebar")

        <section class="user-main donation-user-main">
            <div class="dashboard-donation-page">

                <header class="donation-flow-hero dashboard-donation-hero">
                    <div>
                        <span class="flow-kicker">
                            Responsible community support
                        </span>

                        <h1>
                            Make a contribution with
                            <span>measurable impact.</span>
                        </h1>

                        <p>
                            Choose an associated organisation,
                            select a cause or programme and create
                            a transparent contribution record for
                            administrator review.
                        </p>
                    </div>

                    <a class="donation-history-link"
                       href="@Url.Action("Donations", "Dashboard")">
                        View my donations
                    </a>
                </header>

                <div class="donation-flow-grid">
                    <section class="flow-card donation-form-card">
                        <header class="flow-form-head">
                            <span>Contribution details</span>
                            <h2>Create your donation record</h2>
                            <p>
                                Complete the required information below.
                                No real payment is processed in this
                                academic demonstration.
                            </p>
                        </header>

                        <div class="flow-form-body">
                            @using (Html.BeginForm(
                                "Create",
                                "Donation",
                                FormMethod.Post,
                                new { id = "mainDonationForm" }))
                            {
                                @Html.AntiForgeryToken()

                                @Html.ValidationSummary(
                                         true,
                                         "Please correct the following information:",
                                         new { @class = "flow-validation-summary" })

                                <section class="flow-section">
                                    <div class="flow-section-title">
                                        <span class="flow-step">01</span>
                                        <span>Select a contribution amount</span>
                                    </div>

                                    <div class="amount-presets">
                                        <button type="button"
                                                class="preset-btn @(initialAmount == 1000 ? "active" : "")"
                                                data-amount="1000">
                                            PKR 1,000
                                        </button>

                                        <button type="button"
                                                class="preset-btn @(initialAmount == 2500 ? "active" : "")"
                                                data-amount="2500">
                                            PKR 2,500
                                        </button>

                                        <button type="button"
                                                class="preset-btn @(initialAmount == 5000 ? "active" : "")"
                                                data-amount="5000">
                                            PKR 5,000
                                        </button>

                                        <button type="button"
                                                class="preset-btn @(initialAmount == 10000 ? "active" : "")"
                                                data-amount="10000">
                                            PKR 10,000
                                        </button>
                                    </div>

                                    <div class="amount-input-wrap">
                                        <span class="currency-code">PKR</span>

                                        @Html.TextBoxFor(
                                                 m => m.FormModel.Amount,
                                                 new
                                                 {
                                                     @class = "flow-control",
                                                     id = "formAmountInput",
                                                     type = "number",
                                                     min = "10",
                                                     step = "10",
                                                     required = "required"
                                                 })
                                    </div>

                                    @Html.ValidationMessageFor(
                                             m => m.FormModel.Amount,
                                             "",
                                             new { @class = "field-validation-error" })
                                </section>

                                <section class="flow-section">
                                    <div class="flow-section-title">
                                        <span class="flow-step">02</span>
                                        <span>Choose where your support goes</span>
                                    </div>

                                    <div class="flow-fields">
                                        <div class="flow-field">
                                            <label for="ngoSelect">
                                                Partner organisation
                                            </label>

                                            @Html.DropDownListFor(
                                                     m => m.FormModel.NGOID,
                                                     new SelectList(
                                                         Model.NGOs,
                                                         "ID",
                                                         "Name",
                                                         Model.FormModel.NGOID),
                                                     new
                                                     {
                                                         @class = "flow-control",
                                                         id = "ngoSelect",
                                                         required = "required"
                                                     })

                                            @Html.ValidationMessageFor(
                                                     m => m.FormModel.NGOID,
                                                     "",
                                                     new { @class = "field-validation-error" })
                                        </div>

                                        <div class="flow-field">
                                            <label for="causeSelect">
                                                Cause or sector
                                            </label>

                                            @Html.DropDownListFor(
                                                     m => m.FormModel.CauseID,
                                                     new SelectList(
                                                         Model.Causes,
                                                         "ID",
                                                         "Name",
                                                         Model.FormModel.CauseID),
                                                     new
                                                     {
                                                         @class = "flow-control",
                                                         id = "causeSelect",
                                                         required = "required"
                                                     })

                                            @Html.ValidationMessageFor(
                                                     m => m.FormModel.CauseID,
                                                     "",
                                                     new { @class = "field-validation-error" })
                                        </div>

                                        <div class="flow-field full">
                                            <label for="programSelect">
                                                Specific programme (optional)
                                            </label>

                                            <select id="programSelect"
                                                    name="FormModel.ProgramID"
                                                    class="flow-control">
                                                <option value="">
                                                    General cause fund
                                                </option>

                                                @foreach (var programme in Model.Programs)
                                                {
                                                    <option value="@programme.ID"
                                                            data-ngoid="@programme.SecondaryID"
                                                            @(Model.FormModel.ProgramID == programme.ID ? "selected" : "")>
                                                        @programme.Name
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </section>

                                <section class="flow-section">
                                    <div class="flow-section-title">
                                        <span class="flow-step">03</span>
                                        <span>Your receipt information</span>
                                    </div>

                                    <div class="flow-fields">
                                        <div class="flow-field">
                                            @Html.LabelFor(
                                                     m => m.FormModel.DonorName)

                                            @Html.TextBoxFor(
                                                     m => m.FormModel.DonorName,
                                                     new
                                                     {
                                                         @class = "flow-control",
                                                         placeholder = "Enter your full name",
                                                         required = "required"
                                                     })

                                            @Html.ValidationMessageFor(
                                                     m => m.FormModel.DonorName,
                                                     "",
                                                     new { @class = "field-validation-error" })
                                        </div>

                                        <div class="flow-field">
                                            @Html.LabelFor(
                                                     m => m.FormModel.DonorEmail)

                                            @Html.TextBoxFor(
                                                     m => m.FormModel.DonorEmail,
                                                     new
                                                     {
                                                         @class = "flow-control",
                                                         placeholder = "name@example.com",
                                                         type = "email",
                                                         required = "required"
                                                     })

                                            @Html.ValidationMessageFor(
                                                     m => m.FormModel.DonorEmail,
                                                     "",
                                                     new { @class = "field-validation-error" })
                                        </div>

                                        <div class="flow-field full">
                                            @Html.LabelFor(
                                                     m => m.FormModel.Message)

                                            @Html.TextAreaFor(
                                                     m => m.FormModel.Message,
                                                     new
                                                     {
                                                         @class = "flow-control",
                                                         rows = "3",
                                                         placeholder = "Add an optional note of encouragement"
                                                     })

                                            @Html.ValidationMessageFor(
                                                     m => m.FormModel.Message,
                                                     "",
                                                     new { @class = "field-validation-error" })
                                        </div>
                                    </div>
                                </section>

                                <section class="flow-section">
                                    <div class="flow-section-title">
                                        <span class="flow-step">04</span>
                                        <span>
                                            Choose a demonstration payment method
                                        </span>
                                    </div>

                                    @Html.HiddenFor(
                                             m => m.FormModel.PaymentRail,
                                             new { id = "hiddenPaymentRail" })

                                    <div class="payment-grid">
                                        <button type="button"
                                                class="payment-option @(initialPaymentRail == "Raast / 1Link" ? "active" : "")"
                                                data-rail="Raast / 1Link">
                                            <span class="payment-code">RT</span>
                                            <strong>Raast / 1Link</strong>
                                            <small>Demo bank transfer</small>
                                        </button>

                                        <button type="button"
                                                class="payment-option @(initialPaymentRail == "JazzCash / SadaPay" ? "active" : "")"
                                                data-rail="JazzCash / SadaPay">
                                            <span class="payment-code">JC</span>
                                            <strong>JazzCash / SadaPay</strong>
                                            <small>Demo mobile wallet</small>
                                        </button>

                                        <button type="button"
                                                class="payment-option @(initialPaymentRail == "Debit/Credit Card" ? "active" : "")"
                                                data-rail="Debit/Credit Card">
                                            <span class="payment-code">CD</span>
                                            <strong>Debit / Credit Card</strong>
                                            <small>Demo card record</small>
                                        </button>
                                    </div>
                                </section>

                                <button type="submit"
                                        class="flow-submit"
                                        id="submitDonationButton">
                                    Create contribution record - PKR
                                    <span id="btnAmountText">
                                        @initialAmount.ToString("N0")
                                    </span>
                                </button>

                                <p class="flow-disclaimer">
                                    Academic demonstration only. No real payment
                                    is processed. Your record will be saved for
                                    administrator review.
                                </p>
                            }
                        </div>
                    </section>

                    <aside class="flow-summary-stack">
                        <section class="flow-card flow-summary">
                            <div class="flow-summary-title">
                                <b>DN</b>
                                <div>
                                    <span>Live preview</span>
                                    <h3>Donation summary</h3>
                                </div>
                            </div>

                            <div class="summary-row">
                                <span>Organisation</span>
                                <strong id="summaryNgo">
                                    @selectedNgoName
                                </strong>
                            </div>

                            <div class="summary-row">
                                <span>Cause</span>
                                <strong id="summaryCause">
                                    @selectedCauseName
                                </strong>
                            </div>

                            <div class="summary-row">
                                <span>Programme</span>
                                <strong id="summaryProgram">
                                    General cause fund
                                </strong>
                            </div>

                            <div class="summary-row">
                                <span>Payment method</span>
                                <strong id="summaryRail">
                                    @initialPaymentRail
                                </strong>
                            </div>

                            <div class="summary-row summary-total">
                                <span>Total contribution</span>
                                <strong id="summaryAmount">
                                    PKR @initialAmount.ToString("N0")
                                </strong>
                            </div>
                        </section>

                        <section class="workflow-card">
                            <h4>Transparent review workflow</h4>

                            <div class="workflow-step">
                                <b>01</b>
                                <div>
                                    <strong>Create record</strong>
                                    <span>
                                        Your contribution begins with Pending status.
                                    </span>
                                </div>
                            </div>

                            <div class="workflow-step">
                                <b>02</b>
                                <div>
                                    <strong>Track personally</strong>
                                    <span>
                                        The record appears inside My Donations.
                                    </span>
                                </div>
                            </div>

                            <div class="workflow-step">
                                <b>03</b>
                                <div>
                                    <strong>Administrator review</strong>
                                    <span>
                                        An administrator reviews and updates its status.
                                    </span>
                                </div>
                            </div>
                        </section>

                        <section class="donation-safety-note">
                            <strong>Academic demonstration</strong>
                            <span>
                                This workflow records contribution data but
                                does not process a real financial transaction.
                            </span>
                        </section>
                    </aside>
                </div>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="@Url.Content("~/Scripts/jquery-3.7.0.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>

    <script>
        (function ($) {
            "use strict";

            function formatAmount(amount) {
                return Number(amount || 0).toLocaleString();
            }

            function updateSummary() {
                var amount = parseFloat($("#formAmountInput").val()) || 0;
                var ngoText = $("#ngoSelect option:selected").text();
                var causeText = $("#causeSelect option:selected").text();
                var programText = $("#programSelect option:selected").text();

                $("#summaryAmount").text(
                    "PKR " + formatAmount(amount)
                );

                $("#btnAmountText").text(
                    formatAmount(amount)
                );

                $("#summaryNgo").text(
                    $.trim(ngoText) || "Not selected"
                );

                $("#summaryCause").text(
                    $.trim(causeText) || "Not selected"
                );

                $("#summaryProgram").text(
                    $.trim(programText) || "General cause fund"
                );
            }

            function filterProgrammes() {
                var selectedNgoId = $("#ngoSelect").val();
                var selectedOption = $("#programSelect option:selected");

                $("#programSelect option").each(function () {
                    var programmeNgoId = $(this).data("ngoid");
                    var shouldShow = !programmeNgoId ||
                        String(programmeNgoId) === String(selectedNgoId);

                    $(this).toggle(shouldShow);
                });

                if (selectedOption.length && selectedOption.is(":hidden")) {
                    $("#programSelect").val("");
                }
            }

            $(function () {
                $(".preset-btn").on("click", function () {
                    $(".preset-btn").removeClass("active");
                    $(this).addClass("active");

                    $("#formAmountInput").val(
                        $(this).data("amount")
                    );

                    updateSummary();
                });

                $(".payment-option").on("click", function () {
                    var paymentRail = $(this).data("rail");

                    $(".payment-option").removeClass("active");
                    $(this).addClass("active");

                    $("#hiddenPaymentRail").val(paymentRail);
                    $("#summaryRail").text(paymentRail);
                });

                $("#formAmountInput").on("input", function () {
                    $(".preset-btn").removeClass("active");
                    updateSummary();
                });

                $("#ngoSelect").on("change", function () {
                    filterProgrammes();
                    updateSummary();
                });

                $("#causeSelect, #programSelect").on(
                    "change",
                    updateSummary
                );

                $("#mainDonationForm").on("submit", function () {
                    var button = $("#submitDonationButton");

                    if ($(this).valid && !$(this).valid()) {
                        return false;
                    }

                    button.prop("disabled", true);
                    button.addClass("is-submitting");
                    button.html("Creating your contribution record...");

                    return true;
                });

                filterProgrammes();
                updateSummary();
            });
        })(jQuery);
    </script>
}
